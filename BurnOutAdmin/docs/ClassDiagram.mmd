    +ObservableCollection~SidebarMenuItem~ MenuItems
    +ToggleSidebarCommand
    +NavigateToPageCommand
    +LogoutCommand
}

class DashboardViewModel {
    -IDashboardService _dashboardService
    +int ActiveClientsCount
    +int TodayNfcAccessCount
    +int AlertsCount
    +string SystemStatusText
    +SystemStatus SystemStatus
    +int ActiveChallengesCount
    +int ActiveProgrammesCount
    +int ExpiringSubscriptionsCount
    +bool IsOnline
    +ObservableCollection~DashboardNfcEntry~ RecentNfcAccesses
    +LoadDashboardDataCommand
}

class ClientsViewModel {
    -IClientService _clientService
    -IAlertService _alertService
    -INfcOrchestrator _orchestrator
    -IRfidReaderService _rfidReader
    -IProgramAssignmentService _assignmentService
    +ObservableCollection~Client~ FilteredClients
    +Client? SelectedClient
    +string SearchText
    +string SelectedStatus
    +bool IsFormOpen
    +bool IsEditMode
    +bool IsWaitingForRfidScan
    +bool IsBindMode
    +int? BindTargetClientId
    +string BindStatusText
    +bool IsClientProgramsPanelOpen
    +ObservableCollection~ClientProgramAssignment~ ClientPrograms
    +string FormFirstName
    +string FormLastName
    +string FormEmail
    +string? FormNfcUid
    +string FormStatus
    +DateTime FormStartDate
    +DateTime FormEndDate
    +bool FormAutoRenewal
    +bool HasSelectedClient
    +bool CanSave
    +LoadClientsCommand
    +SaveClientCommand
    +DeleteClientCommand
    +OpenAddFormCommand
    +OpenEditFormCommand
    +StartBindModeCommand
    +CancelBindModeCommand
    +ShowClientProgramsCommand
}

class ProgrammesViewModel {
    -IProgrammeService _programmeService
    +ObservableCollection~Programme~ Programmes
    +Programme? SelectedProgramme
    +LoadProgrammesCommand
    +AddProgrammeCommand
    +EditProgrammeCommand
}

class ChallengesViewModel {
    -IChallengeService _challengeService
    +ObservableCollection~Challenge~ Challenges
    +Challenge? SelectedChallenge
    +LoadChallengesCommand
    +AddChallengeCommand
    +ViewChallengeDetailsCommand
}

class NfcLogsViewModel {
    -INfcService _nfcService
    -INfcOrchestrator _orchestrator
    -IRfidReaderService _rfidReader
    +ObservableCollection~NfcLog~ NfcLogs
    +NfcLog? SelectedLog
    +bool ShowTodayOnly
    +string SearchText
    +bool IsLiveActive
    +bool IsReaderConnected
    +bool IsMqttConnected
    +string SimulateUid
    +LoadNfcLogsCommand
    +StartLiveCommand
    +StopLiveCommand
    +ClearLogsCommand
    +ToggleFilterCommand
    +SimulateScanCommand
}

class SettingsViewModel {
    +bool NotificationsEnabled
    +bool DarkModeEnabled
    +bool AutoSyncEnabled
    +string SyncInterval
    +string AppVersion
    +SaveSettingsCommand
    +ResetSettingsCommand
    +ClearCacheCommand
    +ExportDataCommand
    +ShowAboutCommand
}

