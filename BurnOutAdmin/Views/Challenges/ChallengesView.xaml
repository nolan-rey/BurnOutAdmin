<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels"
             xmlns:cards="clr-namespace:BurnOutAdmin.ViewModels.Challenges"
             x:Class="BurnOutAdmin.Views.Challenges.ChallengesView"
             x:DataType="vm:ChallengesViewModel">

    <!-- Root Grid — permet l'empilement des overlays modaux -->
    <Grid BackgroundColor="#F1F5F9">

        <!-- ═══════════ CONTENU PRINCIPAL ═══════════ -->
        <Grid Padding="28,24" RowDefinitions="Auto,*">

            <!-- ─── En-tête ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,20" ColumnDefinitions="*,Auto">

                <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                    <!-- Icône trophy -->
                    <Border BackgroundColor="#512BD4" StrokeThickness="0"
                            WidthRequest="48" HeightRequest="48"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="&#xEBD2;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Challenges" TextColor="#94A3B8" FontSize="12"/>
                            <Label Text="›" TextColor="#CBD5E1" FontSize="12"/>
                            <Label Text="Gestion des défis" TextColor="#475569" FontSize="12" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Label Text="Challenges" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Créez et gérez les défis pour vos membres."
                               FontSize="13" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Button Grid.Column="1"
                        Text="+ Nouveau challenge"
                        Command="{Binding OpenCreateCommand}"
                        BackgroundColor="#512BD4" TextColor="White"
                        FontAttributes="Bold" FontSize="13"
                        Padding="18,10" CornerRadius="8"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- ─── Deux colonnes ─── -->
            <Grid Grid.Row="1" ColumnDefinitions="400,*" ColumnSpacing="20">

                <!-- ══ GAUCHE : Liste des challenges ══ -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">

                        <!-- En-tête colonne gauche -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <Label Grid.Column="0" Text="Tous les challenges"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#1E293B" VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#EEF2FF" StrokeThickness="0"
                                    Padding="10,4" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding FilteredChallenges.Count}"
                                       FontSize="12" TextColor="#512BD4" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Onglets filtres -->
                        <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,12">

                            <Button Text="Tous" Command="{Binding SetFilterAllCommand}"
                                    FontSize="12" FontAttributes="Bold" Padding="12,6" CornerRadius="20">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#512BD4"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterAll}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#F1F5F9"/>
                                        <Setter Property="TextColor" Value="#64748B"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Actifs" Command="{Binding SetFilterActiveCommand}"
                                    FontSize="12" FontAttributes="Bold" Padding="12,6" CornerRadius="20">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#22C55E"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterActive}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#F1F5F9"/>
                                        <Setter Property="TextColor" Value="#64748B"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="À venir" Command="{Binding SetFilterUpcomingCommand}"
                                    FontSize="12" FontAttributes="Bold" Padding="12,6" CornerRadius="20">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterUpcoming}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#F59E0B"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterUpcoming}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#F1F5F9"/>
                                        <Setter Property="TextColor" Value="#64748B"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Terminés" Command="{Binding SetFilterCompletedCommand}"
                                    FontSize="12" FontAttributes="Bold" Padding="12,6" CornerRadius="20">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterCompleted}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#6366F1"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterCompleted}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#F1F5F9"/>
                                        <Setter Property="TextColor" Value="#64748B"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                        </HorizontalStackLayout>

                        <!-- Barre de recherche -->
                        <Border Grid.Row="2"
                                Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="White"
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,0">
                                <Label Grid.Column="0"
                                       Text="&#xE8B6;" FontFamily="MaterialIcons"
                                       FontSize="18" TextColor="#94A3B8"
                                       VerticalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       Text="{Binding SearchText}"
                                       Placeholder="Rechercher un challenge…"
                                       PlaceholderColor="#CBD5E1"
                                       FontSize="13" TextColor="#1E293B"/>
                            </Grid>
                        </Border>

                        <!-- Liste des challenges -->
                        <Grid Grid.Row="3">

                            <!-- État vide -->
                            <VerticalStackLayout IsVisible="{Binding IsListEmpty}"
                                                 VerticalOptions="Center" Padding="16,40" Spacing="12">
                                <Border BackgroundColor="#EEF2FF" StrokeThickness="0"
                                        WidthRequest="64" HeightRequest="64"
                                        StrokeShape="RoundRectangle 16"
                                        HorizontalOptions="Center">
                                    <Label Text="&#xEBD2;" FontFamily="MaterialIcons"
                                           FontSize="32" TextColor="#512BD4"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Aucun challenge trouvé"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#64748B" HorizontalTextAlignment="Center"/>
                                <Label Text="Créez votre premier challenge en cliquant sur « + Nouveau challenge »."
                                       FontSize="12" TextColor="#94A3B8"
                                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- Loader -->
                            <ActivityIndicator IsVisible="{Binding IsBusy}"
                                               IsRunning="{Binding IsBusy}"
                                               Color="#512BD4" HeightRequest="36"
                                               VerticalOptions="Center"/>

                            <!-- Cartes -->
                            <ScrollView IsVisible="{Binding IsListEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                        VerticalScrollBarVisibility="Default">
                                <CollectionView ItemsSource="{Binding FilteredChallenges}"
                                                VerticalScrollBarVisibility="Never">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="cards:ChallengeCardViewModel">

                                            <Border Margin="0,0,0,10"
                                                    BackgroundColor="{Binding CardBackground}"
                                                    Stroke="{Binding CardBorderColor}"
                                                    StrokeThickness="2"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="14,12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectCommand}"/>
                                                </Border.GestureRecognizers>

                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                                                    <!-- Ligne 1 : icône type + nom + badge statut -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                                                        <!-- Icône type challenge -->
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="#EEF2FF" StrokeThickness="0"
                                                                WidthRequest="32" HeightRequest="32"
                                                                StrokeShape="RoundRectangle 8"
                                                                VerticalOptions="Center">
                                                            <Label Text="{Binding TypeIcon}"
                                                                   FontFamily="MaterialIcons"
                                                                   FontSize="16" TextColor="#512BD4"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <Label Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="14" FontAttributes="Bold"
                                                               TextColor="{Binding CardNameColor}"
                                                               VerticalOptions="Center"
                                                               LineBreakMode="TailTruncation"/>

                                                        <!-- Badge statut -->
                                                        <Border Grid.Column="2"
                                                                BackgroundColor="{Binding StatusColor}"
                                                                StrokeThickness="0"
                                                                Padding="8,3"
                                                                StrokeShape="RoundRectangle 10"
                                                                VerticalOptions="Center">
                                                            <Label Text="{Binding StatusText}"
                                                                   FontSize="10" FontAttributes="Bold"
                                                                   TextColor="White"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Ligne 2 : description -->
                                                    <Label Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           FontSize="12" TextColor="#64748B"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>

                                                    <!-- Ligne 3 : dates + participants + actions -->
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                        <HorizontalStackLayout Grid.Column="0" Spacing="12">
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="&#xE878;" FontFamily="MaterialIcons"
                                                                       FontSize="12" TextColor="#94A3B8"
                                                                       VerticalOptions="Center"/>
                                                                <Label Text="{Binding DateRange}"
                                                                       FontSize="11" TextColor="#94A3B8"
                                                                       VerticalOptions="Center"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="&#xE7EF;" FontFamily="MaterialIcons"
                                                                       FontSize="12" TextColor="#94A3B8"
                                                                       VerticalOptions="Center"/>
                                                                <Label Text="{Binding ParticipantLabel}"
                                                                       FontSize="11" TextColor="#94A3B8"
                                                                       VerticalOptions="Center"/>
                                                            </HorizontalStackLayout>
                                                        </HorizontalStackLayout>

                                                        <!-- Bouton Modifier -->
                                                        <Border Grid.Column="1"
                                                                BackgroundColor="#EEF2FF" StrokeThickness="0"
                                                                WidthRequest="28" HeightRequest="28"
                                                                StrokeShape="RoundRectangle 7"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding EditCommand}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="&#xE3C9;" FontFamily="MaterialIcons"
                                                                   FontSize="14" TextColor="#512BD4"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Bouton Supprimer -->
                                                        <Border Grid.Column="2"
                                                                BackgroundColor="#FEF2F2" StrokeThickness="0"
                                                                WidthRequest="28" HeightRequest="28"
                                                                StrokeShape="RoundRectangle 7"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding DeleteCommand}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="&#xE872;" FontFamily="MaterialIcons"
                                                                   FontSize="14" TextColor="#EF4444"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>

                                                    </Grid>

                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>

                        </Grid>

                    </Grid>
                </Border>

                <!-- ══ DROITE : Panneau de détail ══ -->
                <Grid Grid.Column="1">

                    <!-- État vide — aucun challenge sélectionné -->
                    <Border IsVisible="{Binding IsDetailEmpty}"
                            BackgroundColor="White"
                            Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Border BackgroundColor="#EEF2FF" StrokeThickness="0"
                                    WidthRequest="72" HeightRequest="72"
                                    StrokeShape="RoundRectangle 20"
                                    HorizontalOptions="Center">
                                <Label Text="&#xEBD2;" FontFamily="MaterialIcons"
                                       FontSize="36" TextColor="#512BD4"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Sélectionnez un challenge"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="#64748B" HorizontalTextAlignment="Center"/>
                            <Label Text="Cliquez sur un challenge dans la liste&#x0a;pour afficher ses détails et ses participants."
                                   FontSize="13" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Détail challenge -->
                    <Border IsVisible="{Binding IsDetailEmpty, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="White"
                            Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="24">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">

                            <!-- En-tête détail -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,0,0,16">

                                <!-- Icône type (grande) -->
                                <Border Grid.Column="0"
                                        BackgroundColor="#EEF2FF" StrokeThickness="0"
                                        WidthRequest="56" HeightRequest="56"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding SelectedCard.TypeIcon}"
                                           FontFamily="MaterialIcons"
                                           FontSize="28" TextColor="#512BD4"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- Nom + badges -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedCard.Name}"
                                           FontSize="18" FontAttributes="Bold" TextColor="#0F172A"
                                           LineBreakMode="WordWrap"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="{Binding SelectedCard.StatusColor}"
                                                StrokeThickness="0" Padding="8,3"
                                                StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding SelectedCard.StatusText}"
                                                   FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0"
                                                Padding="8,3" StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding SelectedCard.TypeText}"
                                                   FontSize="11" TextColor="#64748B"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Boutons actions header -->
                                <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Start">

                                    <!-- Bouton Modifier -->
                                    <Border BackgroundColor="#EEF2FF" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectedCard.EditCommand}"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" Padding="12,7">
                                            <Label Text="&#xE3C9;" FontFamily="MaterialIcons"
                                                   FontSize="14" TextColor="#512BD4"
                                                   VerticalOptions="Center"/>
                                            <Label Text="Modifier" FontSize="12" FontAttributes="Bold"
                                                   TextColor="#512BD4" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Bouton Supprimer -->
                                    <Border BackgroundColor="#FEF2F2" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectedCard.DeleteCommand}"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" Padding="12,7">
                                            <Label Text="&#xE872;" FontFamily="MaterialIcons"
                                                   FontSize="14" TextColor="#EF4444"
                                                   VerticalOptions="Center"/>
                                            <Label Text="Supprimer" FontSize="12" FontAttributes="Bold"
                                                   TextColor="#EF4444" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Grid>

                            <!-- Infos du challenge -->
                            <Border Grid.Row="1"
                                    BackgroundColor="#F8FAFC" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,16">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">

                                    <Label Grid.Row="0"
                                           Text="{Binding SelectedCard.Description}"
                                           FontSize="13" TextColor="#475569"
                                           LineBreakMode="WordWrap"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <!-- Période -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="&#xE878;" FontFamily="MaterialIcons"
                                                       FontSize="13" TextColor="#94A3B8"
                                                       VerticalOptions="Center"/>
                                                <Label Text="Période" FontSize="11" TextColor="#94A3B8"
                                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding SelectedCard.DateRange}"
                                                   FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                                            <Label Text="{Binding SelectedCard.DaysLeft, StringFormat='{0} jours restants'}"
                                                   FontSize="11" TextColor="#94A3B8"/>
                                        </VerticalStackLayout>

                                        <!-- Objectif -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="&#xE153;" FontFamily="MaterialIcons"
                                                       FontSize="13" TextColor="#94A3B8"
                                                       VerticalOptions="Center"/>
                                                <Label Text="Objectif" FontSize="11" TextColor="#94A3B8"
                                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding SelectedCard.GoalText}"
                                                   FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Récompense -->
                                    <HorizontalStackLayout Grid.Row="2" Spacing="10">
                                        <Border BackgroundColor="#FEF9C3" StrokeThickness="0"
                                                WidthRequest="32" HeightRequest="32"
                                                StrokeShape="RoundRectangle 8">
                                            <Label Text="&#xE8F6;" FontFamily="MaterialIcons"
                                                   FontSize="16" TextColor="#CA8A04"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Récompense" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold"/>
                                            <Label Text="{Binding SelectedCard.RewardDescription}"
                                                   FontSize="13" TextColor="#1E293B"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <!-- Participants count -->
                                    <HorizontalStackLayout Grid.Row="3" Spacing="10">
                                        <Border BackgroundColor="#EEF2FF" StrokeThickness="0"
                                                WidthRequest="32" HeightRequest="32"
                                                StrokeShape="RoundRectangle 8">
                                            <Label Text="&#xE7EF;" FontFamily="MaterialIcons"
                                                   FontSize="16" TextColor="#512BD4"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="{Binding SelectedCard.ParticipantLabel}"
                                               FontSize="13" TextColor="#1E293B" FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>

                            <!-- Section Participants -->
                            <Grid Grid.Row="2" RowDefinitions="Auto,*">

                                <!-- Titre section + bouton Ajouter -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <Label Grid.Column="0" Text="Participants"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#1E293B" VerticalOptions="Center"/>
                                    <Border Grid.Column="1"
                                            BackgroundColor="#512BD4" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenAssignCommand}"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" Padding="12,7">
                                            <Label Text="&#xE7FE;" FontFamily="MaterialIcons"
                                                   FontSize="14" TextColor="White"
                                                   VerticalOptions="Center"/>
                                            <Label Text="Ajouter" FontSize="12" FontAttributes="Bold"
                                                   TextColor="White" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Liste / état vide participants -->
                                <Grid Grid.Row="1">

                                    <!-- État vide -->
                                    <VerticalStackLayout IsVisible="{Binding Participants.Count, Converter={StaticResource IsZeroConverter}}"
                                                         VerticalOptions="Center" Spacing="10">
                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0"
                                                WidthRequest="56" HeightRequest="56"
                                                StrokeShape="RoundRectangle 14"
                                                HorizontalOptions="Center">
                                            <Label Text="&#xE7EF;" FontFamily="MaterialIcons"
                                                   FontSize="28" TextColor="#94A3B8"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="Aucun participant"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Ajoutez des clients à ce challenge."
                                               FontSize="12" TextColor="#CBD5E1"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>

                                    <!-- Liste participants -->
                                    <ScrollView VerticalScrollBarVisibility="Default">
                                        <CollectionView ItemsSource="{Binding Participants}"
                                                        VerticalScrollBarVisibility="Never">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="cards:ChallengeParticipantRowViewModel">

                                                    <Border Margin="0,0,0,10"
                                                            BackgroundColor="#FAFAFA"
                                                            Stroke="#E2E8F0" StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="14,12">
                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

                                                            <!-- Ligne : avatar + nom + % + actions -->
                                                            <Grid Grid.Row="0"
                                                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                                  ColumnSpacing="10">

                                                                <!-- Avatar initiales -->
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#512BD4" StrokeThickness="0"
                                                                        WidthRequest="36" HeightRequest="36"
                                                                        StrokeShape="RoundRectangle 18">
                                                                    <Label Text="{Binding Initials}"
                                                                           FontSize="12" FontAttributes="Bold"
                                                                           TextColor="White"
                                                                           HorizontalOptions="Center"
                                                                           VerticalOptions="Center"/>
                                                                </Border>

                                                                <!-- Nom + progression -->
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                                    <Label Text="{Binding ClientName}"
                                                                           FontSize="13" FontAttributes="Bold"
                                                                           TextColor="#1E293B"/>
                                                                    <Label Text="{Binding ProgressText}"
                                                                           FontSize="11" TextColor="#64748B"/>
                                                                </VerticalStackLayout>

                                                                <!-- Pourcentage badge -->
                                                                <Border Grid.Column="2"
                                                                        BackgroundColor="#EEF2FF" StrokeThickness="0"
                                                                        Padding="8,3" StrokeShape="RoundRectangle 8"
                                                                        VerticalOptions="Center">
                                                                    <Label Text="{Binding PercentText}"
                                                                           FontSize="11" FontAttributes="Bold"
                                                                           TextColor="#512BD4"/>
                                                                </Border>

                                                                <!-- Bouton mise à jour progression -->
                                                                <Border Grid.Column="3"
                                                                        BackgroundColor="#F0FDF4" StrokeThickness="1"
                                                                        Stroke="#86EFAC"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="30" HeightRequest="30"
                                                                        VerticalOptions="Center">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding UpdateCommand}"/>
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="&#xE8E5;" FontFamily="MaterialIcons"
                                                                           FontSize="14" TextColor="#16A34A"
                                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                </Border>

                                                                <!-- Bouton retirer -->
                                                                <Border Grid.Column="4"
                                                                        BackgroundColor="#FEF2F2" StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="30" HeightRequest="30"
                                                                        VerticalOptions="Center">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding RemoveCommand}"/>
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="&#xE5CD;" FontFamily="MaterialIcons"
                                                                           FontSize="14" TextColor="#EF4444"
                                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                </Border>

                                                            </Grid>

                                                            <!-- Barre de progression -->
                                                            <ProgressBar Grid.Row="1"
                                                                         Progress="{Binding ProgressRatio}"
                                                                         ProgressColor="#512BD4"
                                                                         HeightRequest="6"/>

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </ScrollView>

                                </Grid>
                            </Grid>

                            <!-- Bouton bas "Ajouter des participants" -->
                            <Border Grid.Row="3"
                                    BackgroundColor="#512BD4" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Margin="0,16,0,0" Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAssignCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Padding="0,14">
                                    <Label Text="&#xE7FE;" FontFamily="MaterialIcons"
                                           FontSize="18" TextColor="White" VerticalOptions="Center"/>
                                    <Label Text="Ajouter des participants"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>

            </Grid>
        </Grid>

        <!-- ═══════════ OVERLAY 1 : Créer / Modifier challenge ═══════════ -->
        <Grid IsVisible="{Binding IsEditModalOpen}" BackgroundColor="#AA000000">

            <Border BackgroundColor="White"
                    WidthRequest="560"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">

                    <!-- Titre modal -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,4">
                        <Border Grid.Column="0"
                                BackgroundColor="#EEF2FF" StrokeThickness="0"
                                WidthRequest="36" HeightRequest="36"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="&#xEBD2;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="#512BD4"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding EditModalTitle}"
                               FontSize="18" FontAttributes="Bold" TextColor="#1E293B"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="2"
                                BackgroundColor="#F1F5F9" StrokeThickness="0"
                                WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelEditCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;" FontFamily="MaterialIcons"
                                   FontSize="16" TextColor="#64748B"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Nom -->
                    <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Entry Text="{Binding ModalName}"
                               Placeholder="Nom du challenge *"
                               PlaceholderColor="#94A3B8"
                               FontSize="14" TextColor="#1E293B" Margin="14,0"/>
                    </Border>

                    <!-- Description -->
                    <Border Grid.Row="2" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White"
                            MinimumHeightRequest="76">
                        <Editor Text="{Binding ModalDescription}"
                                Placeholder="Description (optionnel)"
                                PlaceholderColor="#94A3B8"
                                FontSize="13" TextColor="#1E293B"
                                Margin="14,8" AutoSize="TextChanges"/>
                    </Border>

                    <!-- Type + Statut -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Picker Title="Type" ItemsSource="{Binding ChallengeTypeItems}"
                                    SelectedIndex="{Binding ModalTypeIndex}"
                                    FontSize="13" TextColor="#1E293B"
                                    TitleColor="#94A3B8" Margin="14,0"/>
                        </Border>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Picker Title="Statut" ItemsSource="{Binding ChallengeStatusItems}"
                                    SelectedIndex="{Binding ModalStatusIndex}"
                                    FontSize="13" TextColor="#1E293B"
                                    TitleColor="#94A3B8" Margin="14,0"/>
                        </Border>
                    </Grid>

                    <!-- Dates -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*" Padding="14,0" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xE878;" FontFamily="MaterialIcons"
                                       FontSize="14" TextColor="#64748B" VerticalOptions="Center"/>
                                <DatePicker Grid.Column="1" Date="{Binding ModalStartDate}"
                                            FontSize="12" TextColor="#1E293B"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*" Padding="14,0" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xE878;" FontFamily="MaterialIcons"
                                       FontSize="14" TextColor="#64748B" VerticalOptions="Center"/>
                                <DatePicker Grid.Column="1" Date="{Binding ModalEndDate}"
                                            FontSize="12" TextColor="#1E293B"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Objectif + Unité -->
                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Entry Text="{Binding ModalTargetGoal}"
                                   Placeholder="Objectif (nombre) *"
                                   PlaceholderColor="#94A3B8" Keyboard="Numeric"
                                   FontSize="14" TextColor="#1E293B" Margin="14,0"/>
                        </Border>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Entry Text="{Binding ModalGoalUnit}"
                                   Placeholder="Unité (ex : séances, km…)"
                                   PlaceholderColor="#94A3B8"
                                   FontSize="14" TextColor="#1E293B" Margin="14,0"/>
                        </Border>
                    </Grid>

                    <!-- Récompense -->
                    <Border Grid.Row="6" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto,*" Padding="14,0" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="&#xE8F6;" FontFamily="MaterialIcons"
                                   FontSize="14" TextColor="#CA8A04" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding ModalReward}"
                                   Placeholder="Récompense (optionnel)"
                                   PlaceholderColor="#94A3B8"
                                   FontSize="14" TextColor="#1E293B"/>
                        </Grid>
                    </Border>

                    <!-- Boutons -->
                    <Grid Grid.Row="7" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelEditCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Enregistrer"
                                Command="{Binding ConfirmEditCommand}"
                                BackgroundColor="#512BD4" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════ OVERLAY 2 : Assigner des participants ═══════════ -->
        <Grid IsVisible="{Binding IsAssignModalOpen}" BackgroundColor="#AA000000">

            <Border BackgroundColor="White"
                    WidthRequest="520"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,220,Auto" RowSpacing="18">

                    <!-- En-tête -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ajouter des participants"
                                   FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="{Binding SelectedCard.Name}"
                                   FontSize="14" TextColor="#512BD4" FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#F1F5F9" StrokeThickness="0"
                                WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelAssignCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;" FontFamily="MaterialIcons"
                                   FontSize="16" TextColor="#64748B"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Titre liste -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Clients disponibles (actifs, non inscrits)"
                               FontSize="13" FontAttributes="Bold" TextColor="#374151"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#512BD4" StrokeThickness="0"
                                Padding="10,4" StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding SelectableClients.Count}"
                                   FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Liste clients -->
                    <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Default">
                        <CollectionView ItemsSource="{Binding SelectableClients}"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClientSelectionViewModel">
                                    <Border Margin="0,0,0,8"
                                            BackgroundColor="{Binding RowBackground}"
                                            Stroke="{Binding CheckBorderColor}"
                                            StrokeThickness="1.5" StrokeShape="RoundRectangle 10"
                                            Padding="14,11">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleSelectionCommand}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#512BD4" StrokeThickness="0"
                                                    WidthRequest="36" HeightRequest="36"
                                                    StrokeShape="RoundRectangle 18">
                                                <Label Text="{Binding Initials}"
                                                       FontSize="12" FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding FullName}"
                                                   FontSize="14" TextColor="#1E293B" VerticalOptions="Center"/>
                                            <!-- Checkbox -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding CheckBackground}"
                                                    Stroke="{Binding CheckBorderColor}" StrokeThickness="2"
                                                    WidthRequest="22" HeightRequest="22"
                                                    StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                                <Label Text="&#xE876;" FontFamily="MaterialIcons"
                                                       FontSize="13" TextColor="White"
                                                       IsVisible="{Binding IsSelected}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>

                    <!-- Boutons -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelAssignCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Ajouter au challenge"
                                Command="{Binding ConfirmAssignCommand}"
                                BackgroundColor="#22C55E" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════ OVERLAY 3 : Mise à jour progression ═══════════ -->
        <Grid IsVisible="{Binding IsProgressModalOpen}" BackgroundColor="#AA000000">

            <Border BackgroundColor="White"
                    WidthRequest="400"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">

                    <!-- Titre -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                BackgroundColor="#F0FDF4" StrokeThickness="0"
                                WidthRequest="36" HeightRequest="36"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="&#xE8E5;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="#16A34A"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ProgressModalTitle}"
                                   FontSize="16" FontAttributes="Bold" TextColor="#1E293B"
                                   LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding ProgressModalSubtitle}"
                                   FontSize="11" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2"
                                BackgroundColor="#F1F5F9" StrokeThickness="0"
                                WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelProgressCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;" FontFamily="MaterialIcons"
                                   FontSize="16" TextColor="#64748B"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Label -->
                    <Label Grid.Row="1" Text="Nouvelle valeur de progression :"
                           FontSize="13" TextColor="#374151" FontAttributes="Bold"/>

                    <!-- Saisie valeur -->
                    <Border Grid.Row="2" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Entry Text="{Binding NewProgressValue}"
                               Placeholder="Ex : 15"
                               PlaceholderColor="#94A3B8"
                               Keyboard="Numeric"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalTextAlignment="Center"
                               Margin="14,6"/>
                    </Border>

                    <!-- Boutons -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelProgressCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Enregistrer"
                                Command="{Binding ConfirmProgressCommand}"
                                BackgroundColor="#512BD4" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

    </Grid>
</ContentView>
