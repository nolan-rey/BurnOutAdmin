<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.Auth"
             x:Class="BurnOutAdmin.Views.Auth.LoginView"
             x:DataType="vm:LoginViewModel"
             Title="Connexion"
             BackgroundColor="#F1F5F9">

    <Grid>

        <!-- ── Fond décoratif (gradient simulé) ──────────────────── -->
        <BoxView Color="#512BD4" VerticalOptions="Start" HeightRequest="280" />

        <!-- ── Carte de connexion centrée ────────────────────────── -->
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center">
            <Border WidthRequest="420"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="40,36"
                    Margin="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Logo / Titre -->
                    <Label Text="&#xEBD2;"
                           FontFamily="MaterialIcons"
                           FontSize="48"
                           TextColor="#512BD4"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8" />

                    <Label Text="BurnOut Admin"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1E293B"
                           HorizontalOptions="Center" />

                    <Label Text="Connectez-vous pour accéder au tableau de bord"
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           Margin="0,6,0,32" />

                    <!-- ── Champ Email ──────────────────────────── -->
                    <Label Text="Adresse e-mail"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           Margin="0,0,0,6" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xE0BE;"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="#94A3B8"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="admin@burnout.fr"
                                   PlaceholderColor="#CBD5E1"
                                   TextColor="#1E293B"
                                   FontSize="14"
                                   HeightRequest="48"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   BackgroundColor="Transparent"
                                   Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- ── Champ Mot de passe ───────────────────── -->
                    <Label Text="Mot de passe"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           Margin="0,0,0,6" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xE897;"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="#94A3B8"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Entry Text="{Binding Password}"
                                   Placeholder="••••••••"
                                   PlaceholderColor="#CBD5E1"
                                   TextColor="#1E293B"
                                   FontSize="14"
                                   HeightRequest="48"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginCommand}"
                                   BackgroundColor="Transparent"
                                   Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- ── Message d'erreur ──────────────────────── -->
                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            Padding="14,10"
                            Margin="0,0,0,20"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xE000;"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="#EF4444"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="#DC2626"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- ── Bouton de connexion ───────────────────── -->
                    <Button Text="Se connecter"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="10" />

                    <!-- ── Indicateur de chargement ──────────────── -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#512BD4"
                                       Margin="0,14,0,0"
                                       HorizontalOptions="Center" />

                    <!-- ── Mention API ────────────────────────────── -->
                    <Label Text="Authentification Firebase — CallOfPhoenix API"
                           FontSize="11"
                           TextColor="#CBD5E1"
                           HorizontalOptions="Center"
                           Margin="0,24,0,0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>

    </Grid>
</ContentPage>
