<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.Auth"
             x:Class="BurnOutAdmin.Views.Auth.LoginView"
             x:DataType="vm:LoginViewModel"
             Title="Connexion">

    <Grid ColumnDefinitions="2*,3*">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- PANNEAU GAUCHE — Branding Call of Phoenix                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" BackgroundColor="#000000">

            <!-- Image phoenix en fond plein -->
            <Image Source="cop_phoenix_blue.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   Opacity="0.85"/>

            <!-- Overlay dégradé bas→haut pour lisibilité du texte -->
            <BoxView VerticalOptions="Fill" HorizontalOptions="Fill">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#88000000" Offset="0.4"/>
                        <GradientStop Color="#EE000000" Offset="1"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Contenu par-dessus -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="0">

                <!-- En-tête : nom de la salle -->
                <VerticalStackLayout Grid.Row="0" Padding="40,40,40,0" Spacing="2">
                    <Label Text="CALL OF PHOENIX" FontSize="22" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="3"/>
                    <Label Text="Espace Administration" FontSize="13"
                           TextColor="#93C5FD" CharacterSpacing="1"/>
                </VerticalStackLayout>

                <!-- Centre vide (laisse le phoenix visible) -->
                <BoxView Grid.Row="1" Color="Transparent"/>

                <!-- Bas : slogan + features -->
                <VerticalStackLayout Grid.Row="2" Padding="40,0,40,40" Spacing="20">

                    <Label Text="«&#x202F;La renaissance de votre corps et de votre esprit&#x202F;»"
                           FontSize="14" TextColor="#E0E7FF" FontAttributes="Italic"
                           LineBreakMode="WordWrap" HorizontalOptions="Start"/>

                    <BoxView HeightRequest="1" BackgroundColor="#FFFFFF30"/>

                    <!-- Features -->
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="12">
                            <Border BackgroundColor="#FFFFFF18" WidthRequest="34" HeightRequest="34"
                                    VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="&#xE7EF;" FontFamily="MaterialIcons" FontSize="18"
                                       TextColor="#93C5FD" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                <Label Text="Gestion des membres" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Clients, abonnements et accès NFC" FontSize="11" TextColor="#93C5FD"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Border BackgroundColor="#FFFFFF18" WidthRequest="34" HeightRequest="34"
                                    VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="&#xEBD2;" FontFamily="MaterialIcons" FontSize="18"
                                       TextColor="#93C5FD" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                <Label Text="Challenges &amp; Classements" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Podium, progression et récompenses" FontSize="11" TextColor="#93C5FD"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Border BackgroundColor="#FFFFFF18" WidthRequest="34" HeightRequest="34"
                                    VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18"
                                       TextColor="#93C5FD" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                <Label Text="Programmes d'entraînement" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Création, assignation et suivi" FontSize="11" TextColor="#93C5FD"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- PANNEAU DROIT — Formulaire                                 -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Column="1" BackgroundColor="White">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                  Padding="0,48" Spacing="0" WidthRequest="400">

                <!-- En-tête -->
                <Label Text="Connexion" FontSize="30" FontAttributes="Bold"
                       TextColor="#1E293B" Margin="0,0,0,6"/>
                <Label Text="Bienvenue ! Entrez vos identifiants pour continuer."
                       FontSize="14" TextColor="#64748B" Margin="0,0,0,36"
                       LineBreakMode="WordWrap"/>

                <!-- Champ Email -->
                <Label Text="Adresse e-mail" FontSize="13" FontAttributes="Bold"
                       TextColor="#374151" Margin="0,0,0,6"/>
                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                        Padding="14,0" Margin="0,0,0,18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xE0BE;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="#94A3B8" VerticalOptions="Center" Grid.Column="0"/>
                        <Entry Text="{Binding Email}" Placeholder="votre@email.fr"
                               PlaceholderColor="#CBD5E1" TextColor="#1E293B" FontSize="14"
                               HeightRequest="48" Keyboard="Email" ReturnType="Next"
                               BackgroundColor="Transparent" Grid.Column="1"/>
                    </Grid>
                </Border>

                <!-- Champ Mot de passe -->
                <Label Text="Mot de passe" FontSize="13" FontAttributes="Bold"
                       TextColor="#374151" Margin="0,0,0,6"/>
                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                        Padding="14,0" Margin="0,0,0,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xE897;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="#94A3B8" VerticalOptions="Center" Grid.Column="0"/>
                        <Entry Text="{Binding Password}" Placeholder="••••••••"
                               PlaceholderColor="#CBD5E1" TextColor="#1E293B" FontSize="14"
                               HeightRequest="48" IsPassword="True" ReturnType="Done"
                               ReturnCommand="{Binding LoginCommand}"
                               BackgroundColor="Transparent" Grid.Column="1"/>
                    </Grid>
                </Border>

                <!-- Bannière erreur -->
                <Border BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1"
                        Padding="14,10" Margin="0,12,0,0"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xE000;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#EF4444" VerticalOptions="Center" Grid.Column="0"/>
                        <Label Text="{Binding ErrorMessage}" FontSize="13"
                               TextColor="#DC2626" VerticalOptions="Center" Grid.Column="1"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Border>

                <!-- Bouton Se connecter -->
                <Button Text="Se connecter" Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#512BD4" TextColor="White" FontSize="15"
                        FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                        Margin="0,24,0,0"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="#512BD4" Margin="0,12,0,0" HorizontalOptions="Center"/>

                <!-- Séparateur -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,28,0,28">
                    <BoxView Color="#E2E8F0" HeightRequest="1" VerticalOptions="Center" Grid.Column="0"/>
                    <Label Text="ou" FontSize="13" TextColor="#94A3B8" Grid.Column="1"/>
                    <BoxView Color="#E2E8F0" HeightRequest="1" VerticalOptions="Center" Grid.Column="2"/>
                </Grid>

                <!-- Bouton Créer un compte -->
                <Button Text="Créer un compte" Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent" BorderColor="#E2E8F0" BorderWidth="1.5"
                        TextColor="#512BD4" FontSize="14" FontAttributes="Bold"
                        HeightRequest="48" CornerRadius="10"/>

                <!-- Footer -->
                <Label Text="Authentification Firebase · CallOfPhoenix API"
                       FontSize="11" TextColor="#CBD5E1" HorizontalOptions="Center"
                       Margin="0,32,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
