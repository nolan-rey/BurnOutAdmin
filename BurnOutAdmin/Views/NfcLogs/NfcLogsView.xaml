<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BurnOutAdmin.ViewModels"
             xmlns:models="clr-namespace:BurnOutAdmin.Models"
             xmlns:converters="clr-namespace:BurnOutAdmin.Converters"
             x:Class="BurnOutAdmin.Views.NfcLogs.NfcLogsView"
             x:DataType="viewmodels:NfcLogsViewModel"
             BackgroundColor="#F6F7F8">

    <ContentView.Resources>
        <Color x:Key="Primary">#137FEC</Color>
        <Color x:Key="TextDark">#111418</Color>
        <Color x:Key="TextMedium">#6B7280</Color>
        <Color x:Key="TextLight">#9CA3AF</Color>
        <Color x:Key="BorderColor">#E5E7EB</Color>
        <Color x:Key="BgGray50">#F9FAFB</Color>
        <Color x:Key="StatusGreen">#15803D</Color>
        <Color x:Key="StatusGreenBg">#DCFCE7</Color>
        <Color x:Key="StatusRedText">#B91C1C</Color>
        <Color x:Key="StatusRedBg">#FEE2E2</Color>
        <Color x:Key="StatusYellowText">#A16207</Color>
        <Color x:Key="StatusYellowBg">#FEF9C3</Color>
        <converters:InvertedBoolConverter x:Key="InvertedBool"/>
    </ContentView.Resources>

    <Grid Padding="32,24" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">

        <!-- Breadcrumb -->
        <HorizontalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <Label Text="Accueil" FontSize="13" TextColor="{StaticResource TextLight}"/>
            <Label Text="/" FontSize="13" TextColor="{StaticResource TextLight}" Margin="2,0"/>
            <Label Text="Journal NFC" FontSize="13" TextColor="{StaticResource TextDark}" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <!-- Header + Status indicators -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Label Text="Journal NFC" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextDark}"/>
                <Label Text="Historique des accès par carte NFC" FontSize="13" TextColor="{StaticResource TextMedium}"/>
            </VerticalStackLayout>
            <!-- Status badges + Actions -->
            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <!-- Reader status -->
                <Border BackgroundColor="{StaticResource StatusGreenBg}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="10,6"
                        IsVisible="{Binding IsReaderConnected}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#22C55E" StrokeThickness="0" HeightRequest="8" WidthRequest="8" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        </Border>
                        <Label Text="Reader" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource StatusRedBg}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="10,6"
                        IsVisible="{Binding IsReaderConnected, Converter={StaticResource InvertedBool}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#EF4444" StrokeThickness="0" HeightRequest="8" WidthRequest="8" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        </Border>
                        <Label Text="Reader" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusRedText}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <!-- MQTT status -->
                <Border BackgroundColor="{StaticResource StatusGreenBg}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="10,6"
                        IsVisible="{Binding IsMqttConnected}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#22C55E" StrokeThickness="0" HeightRequest="8" WidthRequest="8" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        </Border>
                        <Label Text="MQTT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource StatusRedBg}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="10,6"
                        IsVisible="{Binding IsMqttConnected, Converter={StaticResource InvertedBool}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#EF4444" StrokeThickness="0" HeightRequest="8" WidthRequest="8" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        </Border>
                        <Label Text="MQTT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusRedText}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <!-- Live toggle -->
                <Button Text="Démarrer Live" Command="{Binding StartLiveCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="38" Padding="16,0"
                        IsVisible="{Binding IsLiveActive, Converter={StaticResource InvertedBool}}"/>
                <Button Text="Arrêter Live" Command="{Binding StopLiveCommand}"
                        BackgroundColor="#DC2626" TextColor="White"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="38" Padding="16,0"
                        IsVisible="{Binding IsLiveActive}"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Toolbar: Search + Filter + Simulate + Refresh -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,16">
            <!-- Search -->
            <Border Grid.Column="0" BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" HeightRequest="42">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" Padding="12,0">
                    <Image Grid.Column="0" VerticalOptions="Center" WidthRequest="16" HeightRequest="16">
                        <Image.Source><FontImageSource Glyph="&#x1F50D;" Color="{StaticResource TextLight}" Size="16"/></Image.Source>
                    </Image>
                    <Entry Grid.Column="1" Placeholder="Rechercher par UID, client, résultat..."
                           PlaceholderColor="{StaticResource TextLight}" Text="{Binding SearchText}"
                           TextColor="{StaticResource TextDark}" BackgroundColor="Transparent" FontSize="13"
                           VerticalOptions="Center" Margin="6,0,0,0"/>
                </Grid>
            </Border>
            <!-- Toggle today/all -->
            <Button Grid.Column="1" Command="{Binding ToggleFilterCommand}"
                    BackgroundColor="White" TextColor="{StaticResource TextDark}" BorderColor="{StaticResource BorderColor}" BorderWidth="1"
                    FontSize="12" CornerRadius="8" HeightRequest="42" Padding="14,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowTodayOnly}" Value="True">
                        <Setter Property="Text" Value="Aujourd'hui"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowTodayOnly}" Value="False">
                        <Setter Property="Text" Value="Tout"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <!-- Simulate scan (dev) -->
            <Border Grid.Column="2" BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" HeightRequest="42" Padding="8,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Entry Text="{Binding SimulateUid}" Placeholder="UID" PlaceholderColor="{StaticResource TextLight}"
                           TextColor="{StaticResource TextDark}" BackgroundColor="Transparent" FontSize="12"
                           WidthRequest="100" VerticalOptions="Center"/>
                    <Button Text="Simuler" Command="{Binding SimulateScanCommand}"
                            BackgroundColor="#F3F4F6" TextColor="{StaticResource TextDark}" FontSize="11"
                            CornerRadius="6" HeightRequest="30" Padding="10,0"/>
                </HorizontalStackLayout>
            </Border>
            <!-- Clear -->
            <Button Grid.Column="3" Text="Vider" Command="{Binding ClearLogsCommand}"
                    BackgroundColor="White" TextColor="{StaticResource TextMedium}" BorderColor="{StaticResource BorderColor}" BorderWidth="1"
                    FontSize="12" CornerRadius="8" HeightRequest="42" Padding="14,0"/>
            <!-- Refresh -->
            <Button Grid.Column="4" Text="Actualiser" Command="{Binding RefreshLogsCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold"
                    FontSize="12" CornerRadius="8" HeightRequest="42" Padding="16,0"/>
        </Grid>

        <!-- Live indicator banner -->
        <Border Grid.Row="3" BackgroundColor="#EFF6FF" Stroke="#DBEAFE" StrokeThickness="1" Padding="12,8" Margin="0,0,0,16"
                IsVisible="{Binding IsLiveActive}">
            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
            <HorizontalStackLayout Spacing="8">
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" HeightRequest="8" WidthRequest="8" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                </Border>
                <Label Text="Mode Live actif — Les nouveaux scans apparaissent en temps réel" FontSize="12" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Logs Table Card -->
        <Border Grid.Row="4" BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#000" Offset="0,1" Radius="3" Opacity="0.05"/></Border.Shadow>
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Table Header -->
                <Border Grid.Row="0" BackgroundColor="{StaticResource BgGray50}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10,10,0,0"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="60,*,100,120,100,80" Padding="20,12" BackgroundColor="{StaticResource BgGray50}">
                        <Label Grid.Column="0" Text="HEURE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8"/>
                        <Label Grid.Column="1" Text="CLIENT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8"/>
                        <Label Grid.Column="2" Text="UID" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8"/>
                        <Label Grid.Column="3" Text="RAISON" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8"/>
                        <Label Grid.Column="4" Text="SOURCE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8"/>
                        <Label Grid.Column="5" Text="STATUT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMedium}" CharacterSpacing="0.8" HorizontalTextAlignment="Center"/>
                    </Grid>
                </Border>
                <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="{StaticResource BorderColor}"/>

                <!-- Table Body -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding NfcLogs}" SelectionMode="Single" SelectedItem="{Binding SelectedLog}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="0,60">
                            <Label Text="Aucun log NFC" FontSize="16" TextColor="{StaticResource TextMedium}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                            <Label Text="Démarrez le live ou actualisez pour voir les logs." FontSize="13" TextColor="{StaticResource TextLight}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NfcLog">
                            <Border BackgroundColor="White" StrokeThickness="0" Padding="0">
                                <Grid RowDefinitions="*,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="60,*,100,120,100,80" Padding="20,12">
                                        <!-- Time -->
                                        <Label Grid.Column="0" Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                               FontSize="13" TextColor="{StaticResource TextDark}" VerticalOptions="Center"/>
                                        <!-- Client -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding ClientName}" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextDark}" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <!-- UID -->
                                        <Border Grid.Column="2" BackgroundColor="#F3F4F6" Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                                Padding="6,3" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                            <Label Text="{Binding Uid}" FontSize="11" TextColor="{StaticResource TextMedium}"/>
                                        </Border>
                                        <!-- Reason -->
                                        <Label Grid.Column="3" Text="{Binding Reason}" FontSize="12"
                                               TextColor="{StaticResource TextMedium}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                        <!-- Source -->
                                        <Label Grid.Column="4" Text="{Binding Source}" FontSize="12"
                                               TextColor="{StaticResource TextLight}" VerticalOptions="Center"/>
                                        <!-- Status Badge -->
                                        <HorizontalStackLayout Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center">
                                            <!-- Authorized -->
                                            <Border IsVisible="False" BackgroundColor="{StaticResource StatusGreenBg}" StrokeThickness="0" Padding="8,4">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsAuthorized}" Value="True">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="Autorisé" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}"/>
                                            </Border>
                                            <!-- Pending -->
                                            <Border IsVisible="False" BackgroundColor="{StaticResource StatusYellowBg}" StrokeThickness="0" Padding="8,4">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="En attente" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusYellowText}"/>
                                            </Border>
                                            <!-- Denied (default if not Authorized and not Pending) -->
                                            <Border IsVisible="False" BackgroundColor="{StaticResource StatusRedBg}" StrokeThickness="0" Padding="8,4">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                <Border.Triggers>
                                                    <MultiTrigger TargetType="Border">
                                                        <MultiTrigger.Conditions>
                                                            <BindingCondition Binding="{Binding IsAuthorized}" Value="False"/>
                                                            <BindingCondition Binding="{Binding IsPending}" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </MultiTrigger>
                                                </Border.Triggers>
                                                <Label Text="Refusé" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource StatusRedText}"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Footer -->
                <Border Grid.Row="2" BackgroundColor="{StaticResource BgGray50}" StrokeThickness="0" Padding="20,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0,0,10,10"/></Border.StrokeShape>
                    <Label Text="{Binding NfcLogs.Count, StringFormat='Affichage de {0} logs'}" FontSize="12" TextColor="{StaticResource TextLight}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsBusy}" BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" HeightRequest="48" WidthRequest="48"/>
                <Label Text="Chargement..." FontSize="16" TextColor="White" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
