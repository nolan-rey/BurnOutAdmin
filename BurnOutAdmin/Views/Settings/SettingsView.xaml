<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BurnOutAdmin.ViewModels"
             x:Class="BurnOutAdmin.Views.Settings.SettingsView"
             x:DataType="viewmodels:SettingsViewModel"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="35,30,35,40" MaximumWidthRequest="780">

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- EN-TÊTE                                                -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Paramètres" FontSize="28" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Text="Configuration · Connexions · Compte" FontSize="13" TextColor="#94A3B8"/>
                </VerticalStackLayout>
                <!-- Bouton Actualiser statuts -->
                <Border Grid.Column="1" BackgroundColor="White" Padding="14,10"
                        StrokeThickness="1" Stroke="#E2E8F0" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RefreshStatusCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                                           IsVisible="{Binding IsRefreshing}"
                                           Color="#512BD4" WidthRequest="16" HeightRequest="16"
                                           VerticalOptions="Center"/>
                        <Label Text="&#xE5D5;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#512BD4" VerticalOptions="Center"
                               IsVisible="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"/>
                        <Label Text="Actualiser" FontSize="13" FontAttributes="Bold"
                               TextColor="#512BD4" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARTE PROFIL                                           -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0"
                    Padding="28" Margin="0,0,0,20">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#10000000" Offset="0,2" Radius="8"/></Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">

                    <!-- Avatar -->
                    <Grid Grid.Column="0" WidthRequest="64" HeightRequest="64">
                        <Ellipse Fill="#512BD4" WidthRequest="64" HeightRequest="64"/>
                        <Label Text="{Binding CurrentUserInitials}"
                               FontSize="26" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Infos utilisateur -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="Administrateur connecté" FontSize="11"
                               TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Label Text="{Binding CurrentUserEmail}" FontSize="17"
                               FontAttributes="Bold" TextColor="#1E293B"
                               LineBreakMode="TailTruncation"/>
                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                            <Ellipse Fill="#22C55E" WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                            <Label Text="Session active · Firebase Auth" FontSize="12" TextColor="#64748B"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Bouton déconnexion -->
                    <Border Grid.Column="2" BackgroundColor="#FEF2F2" Padding="16,10"
                            StrokeThickness="1" Stroke="#FECACA" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xE9BA;" FontFamily="MaterialIcons" FontSize="16"
                                   TextColor="#E11D48" VerticalOptions="Center"/>
                            <Label Text="Se déconnecter" FontSize="13" FontAttributes="Bold"
                                   TextColor="#E11D48" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- STATUTS CONNEXION                                      -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Label Text="CONNEXIONS" FontSize="11" FontAttributes="Bold"
                   TextColor="#94A3B8" CharacterSpacing="2" Margin="4,0,0,10"/>

            <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0"
                    Padding="0" Margin="0,0,0,20">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#10000000" Offset="0,2" Radius="8"/></Border.Shadow>
                <VerticalStackLayout>

                    <!-- API REST -->
                    <Grid Padding="24,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EFF6FF" Offset="0"/>
                                    <GradientStop Color="#DBEAFE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="&#xE1D8;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="#3B82F6" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="API CallOfPhoenix" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="{Binding ApiBaseUrl}" FontSize="11" TextColor="#94A3B8"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{Binding ApiBgColor}"
                                Padding="12,6" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="7" HeightRequest="7"
                                         Fill="{Binding ApiDotColor}" VerticalOptions="Center"/>
                                <Label Text="{Binding ApiStatusLabel}" FontSize="12" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="24,0"/>

                    <!-- MQTT Broker -->
                    <Grid Padding="24,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F0FDF4" Offset="0"/>
                                    <GradientStop Color="#DCFCE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="&#xE51F;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="#22C55E" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Broker MQTT" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="{Binding MqttStatusText}" FontSize="11" TextColor="#94A3B8"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{Binding MqttBgColor}"
                                Padding="12,6" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="7" HeightRequest="7"
                                         Fill="{Binding MqttDotColor}" VerticalOptions="Center"/>
                                <Label Text="{Binding MqttStatusLabel}" FontSize="12" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="24,0"/>

                    <!-- Lecteur NFC/RFID -->
                    <Grid Padding="24,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FDF4FF" Offset="0"/>
                                    <GradientStop Color="#FAE8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="&#xEF6D;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="#A855F7" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Lecteur NFC / RFID" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="{Binding NfcStatusText}" FontSize="11" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{Binding NfcBgColor}"
                                Padding="12,6" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="7" HeightRequest="7"
                                         Fill="{Binding NfcDotColor}" VerticalOptions="Center"/>
                                <Label Text="{Binding NfcStatusLabel}" FontSize="12" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CONFIGURATION                                          -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Label Text="CONFIGURATION" FontSize="11" FontAttributes="Bold"
                   TextColor="#94A3B8" CharacterSpacing="2" Margin="4,0,0,10"/>

            <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0"
                    Padding="0" Margin="0,0,0,20">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#10000000" Offset="0,2" Radius="8"/></Border.Shadow>
                <VerticalStackLayout>

                    <!-- API URL -->
                    <Grid Padding="24,16" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="&#xE869;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#94A3B8" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="URL de l'API" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="{Binding ApiBaseUrl}" FontSize="13" FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="24,0"/>

                    <!-- MQTT Host -->
                    <Grid Padding="24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="&#xE51F;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#94A3B8" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Broker MQTT" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="{Binding MqttBrokerHost}" FontSize="13" FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#F8FAFC" Padding="10,6"
                                StrokeThickness="1" Stroke="#E2E8F0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Label Text="{Binding MqttBrokerPort, StringFormat=':{0}'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#64748B"/>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- APPLICATION                                            -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Label Text="APPLICATION" FontSize="11" FontAttributes="Bold"
                   TextColor="#94A3B8" CharacterSpacing="2" Margin="4,0,0,10"/>

            <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0"
                    Padding="0" Margin="0,0,0,8">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#10000000" Offset="0,2" Radius="8"/></Border.Shadow>
                <VerticalStackLayout>

                    <!-- Version -->
                    <Grid Padding="24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="&#xE88E;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#94A3B8" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Version" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="{Binding AppVersion, StringFormat='BurnOut Admin v{0}'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#EEF2FF" Padding="10,5"
                                StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <Label Text="MVP" FontSize="10" FontAttributes="Bold" TextColor="#512BD4"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="24,0"/>

                    <!-- Vider le cache -->
                    <Grid Padding="24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" GestureRecognizers.IsEnabled="False">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCacheCommand}"/>
                            </Grid.GestureRecognizers>
                        </Border>
                        <Label Grid.Column="0" Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#94A3B8" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Cache local" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="Vider les données temporaires" FontSize="13"
                                   FontAttributes="Bold" TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#FEF2F2" Padding="12,7"
                                StrokeThickness="1" Stroke="#FECACA" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCacheCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Vider" FontSize="12" FontAttributes="Bold" TextColor="#E11D48"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="24,0"/>

                    <!-- À propos -->
                    <Grid Padding="24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="&#xE88E;" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="#94A3B8" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="À propos" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="Licences, crédits et informations" FontSize="13"
                                   FontAttributes="Bold" TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#xE5C8;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="#CBD5E1" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowAboutCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
