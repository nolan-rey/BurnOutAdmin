<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramBuilder"
             xmlns:models="clr-namespace:BurnOutAdmin.Models.Program"
             x:Class="BurnOutAdmin.Views.ProgramBuilder.ProgramBuilderPage"
             x:DataType="vm:ProgramBuilderViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Row 0: Program Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Padding="0,0,0,12">
            <Label Text="Program Builder"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Entry Text="{Binding ProgramName}"
                   Placeholder="Program Name"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Entry Text="{Binding ProgramDescription}"
                   Placeholder="Program Description"
                   FontSize="14" />

            <Button Text="+ Add Session"
                    Command="{Binding AddSessionCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Padding="16,8" />
        </VerticalStackLayout>

        <!-- Row 1: Sessions List (only scrollable element) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Sessions}"
                        ItemsLayout="VerticalList"
                        ItemSizingStrategy="MeasureFirstItem">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No sessions yet"
                           FontSize="16"
                           FontAttributes="Italic"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                    <Label Text="Click + Add Session to get started"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionViewModel">

                    <!-- SESSION BLOCK -->
                    <Border Stroke="#512BD4"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,0,0,12"
                            BackgroundColor="#FAFAFA">
                        <VerticalStackLayout Spacing="8">

                            <!-- Session Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Order, StringFormat='S{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#512BD4"
                                       VerticalTextAlignment="Center" />

                                <Entry Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="{Binding ExpandIcon}"
                                        FontSize="12"
                                        BackgroundColor="Transparent"
                                        TextColor="#512BD4"
                                        Padding="8,4"
                                        Command="{Binding ToggleExpandedCommand}" />

                                <Button Grid.Column="3"
                                        Text="+ Category"
                                        FontSize="12"
                                        BackgroundColor="#E8DEF8"
                                        TextColor="#512BD4"
                                        Padding="8,4"
                                        Command="{Binding AddCategoryCommand}" />

                                <Button Grid.Column="4"
                                        Text="✕"
                                        FontSize="14"
                                        BackgroundColor="#FFCDD2"
                                        TextColor="#C62828"
                                        Padding="8,4"
                                        Command="{Binding DeleteSessionCommand}" />
                            </Grid>

                            <!-- Session Content (expandable) -->
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="6">

                                <!-- Categories -->
                                <CollectionView ItemsSource="{Binding Categories}"
                                                ItemsLayout="VerticalList"
                                                ItemSizingStrategy="MeasureFirstItem"
                                                VerticalScrollBarVisibility="Never">

                                    <CollectionView.EmptyView>
                                        <Label Text="No categories – add one"
                                               FontSize="12"
                                               FontAttributes="Italic"
                                               TextColor="Gray"
                                               Margin="10,4" />
                                    </CollectionView.EmptyView>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryViewModel">

                                            <!-- CATEGORY BLOCK -->
                                            <Border Stroke="#7E57C2"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="10"
                                                    Margin="10,0,0,8"
                                                    BackgroundColor="#F3F0FF">
                                                <VerticalStackLayout Spacing="6">

                                                    <!-- Category Header -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding Order, StringFormat='C{0}'}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="#7E57C2"
                                                               VerticalTextAlignment="Center" />

                                                        <Entry Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center" />

                                                        <Button Grid.Column="2"
                                                                Text="{Binding ExpandIcon}"
                                                                FontSize="11"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#7E57C2"
                                                                Padding="6,2"
                                                                Command="{Binding ToggleExpandedCommand}" />

                                                        <Button Grid.Column="3"
                                                                Text="+ SubCat"
                                                                FontSize="11"
                                                                BackgroundColor="#EDE7F6"
                                                                TextColor="#7E57C2"
                                                                Padding="6,2"
                                                                Command="{Binding AddSubCategoryCommand}" />

                                                        <Button Grid.Column="4"
                                                                Text="✕"
                                                                FontSize="12"
                                                                BackgroundColor="#FFCDD2"
                                                                TextColor="#C62828"
                                                                Padding="6,2"
                                                                Command="{Binding DeleteCategoryCommand}" />
                                                    </Grid>

                                                    <!-- Category Content (expandable) -->
                                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="4">

                                                        <!-- SubCategories -->
                                                        <CollectionView ItemsSource="{Binding SubCategories}"
                                                                        ItemsLayout="VerticalList"
                                                                        ItemSizingStrategy="MeasureFirstItem"
                                                                        VerticalScrollBarVisibility="Never">

                                                            <CollectionView.EmptyView>
                                                                <Label Text="No sub-categories – add one"
                                                                       FontSize="11"
                                                                       FontAttributes="Italic"
                                                                       TextColor="Gray"
                                                                       Margin="20,4" />
                                                            </CollectionView.EmptyView>

                                                            <CollectionView.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SubCategoryViewModel">

                                                                    <!-- SUBCATEGORY BLOCK -->
                                                                    <Border Stroke="#B39DDB"
                                                                            StrokeThickness="1"
                                                                            StrokeShape="RoundRectangle 4"
                                                                            Padding="8"
                                                                            Margin="20,0,0,6"
                                                                            BackgroundColor="#F9F7FF">
                                                                        <VerticalStackLayout Spacing="4">

                                                                            <!-- SubCategory Header -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                                <Label Grid.Column="0"
                                                                                       Text="{Binding Order, StringFormat='SC{0}'}"
                                                                                       FontSize="11"
                                                                                       FontAttributes="Bold"
                                                                                       TextColor="#B39DDB"
                                                                                       VerticalTextAlignment="Center" />

                                                                                <Entry Grid.Column="1"
                                                                                       Text="{Binding Name}"
                                                                                       FontSize="13"
                                                                                       FontAttributes="Bold"
                                                                                       VerticalOptions="Center" />

                                                                                <Button Grid.Column="2"
                                                                                        Text="{Binding ExpandIcon}"
                                                                                        FontSize="10"
                                                                                        BackgroundColor="Transparent"
                                                                                        TextColor="#B39DDB"
                                                                                        Padding="4,2"
                                                                                        Command="{Binding ToggleExpandedCommand}" />

                                                                                <Button Grid.Column="3"
                                                                                        Text="✕"
                                                                                        FontSize="11"
                                                                                        BackgroundColor="#FFCDD2"
                                                                                        TextColor="#C62828"
                                                                                        Padding="4,2"
                                                                                        Command="{Binding DeleteSubCategoryCommand}" />
                                                                            </Grid>

                                                                            <!-- SubCategory Properties -->
                                                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                                                <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                                                                    <Label Text="Sets:" FontSize="11" VerticalTextAlignment="Center" />
                                                                                    <Entry Text="{Binding Sets}" FontSize="11" WidthRequest="40" Keyboard="Numeric" />
                                                                                </HorizontalStackLayout>
                                                                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                                                                    <Label Text="Rest:" FontSize="11" VerticalTextAlignment="Center" />
                                                                                    <Entry Text="{Binding RestTime}" FontSize="11" WidthRequest="40" Keyboard="Numeric" />
                                                                                    <Label Text="s" FontSize="11" VerticalTextAlignment="Center" />
                                                                                </HorizontalStackLayout>
                                                                                <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                                                                    <Label Text="Type:" FontSize="11" VerticalTextAlignment="Center" />
                                                                                    <Picker SelectedItem="{Binding Type}" FontSize="11">
                                                                                        <Picker.ItemsSource>
                                                                                            <x:Array Type="{x:Type models:SubCategoryType}">
                                                                                                <models:SubCategoryType>Normal</models:SubCategoryType>
                                                                                                <models:SubCategoryType>Circuit</models:SubCategoryType>
                                                                                                <models:SubCategoryType>AMRAP</models:SubCategoryType>
                                                                                            </x:Array>
                                                                                        </Picker.ItemsSource>
                                                                                    </Picker>
                                                                                </HorizontalStackLayout>
                                                                            </Grid>

                                                                            <!-- SubCategory Content (expandable) -->
                                                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="4">

                                                                                <Button Text="+ Exercise"
                                                                                        FontSize="11"
                                                                                        BackgroundColor="#E8DEF8"
                                                                                        TextColor="#7E57C2"
                                                                                        Padding="6,2"
                                                                                        HorizontalOptions="Start"
                                                                                        Command="{Binding AddExerciseCommand}" />

                                                                                <!-- Exercises -->
                                                                                <CollectionView ItemsSource="{Binding Exercises}"
                                                                                                ItemsLayout="VerticalList"
                                                                                                ItemSizingStrategy="MeasureFirstItem"
                                                                                                VerticalScrollBarVisibility="Never">

                                                                                    <CollectionView.EmptyView>
                                                                                        <Label Text="No exercises – add one"
                                                                                               FontSize="10"
                                                                                               FontAttributes="Italic"
                                                                                               TextColor="Gray"
                                                                                               Margin="30,4" />
                                                                                    </CollectionView.EmptyView>

                                                                                    <CollectionView.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:ExerciseViewModel">

                                                                                            <!-- EXERCISE ROW -->
                                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                                                                                  ColumnSpacing="6"
                                                                                                  Margin="30,2,0,2"
                                                                                                  Padding="4">

                                                                                                <Label Grid.Column="0"
                                                                                                       Text="{Binding Order, StringFormat='{0}.'}"
                                                                                                       FontSize="11"
                                                                                                       TextColor="Gray"
                                                                                                       VerticalTextAlignment="Center" />

                                                                                                <Entry Grid.Column="1"
                                                                                                       Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       VerticalOptions="Center" />

                                                                                                <Label Grid.Column="2"
                                                                                                       Text="Reps:"
                                                                                                       FontSize="10"
                                                                                                       VerticalTextAlignment="Center"
                                                                                                       TextColor="Gray" />

                                                                                                <Entry Grid.Column="3"
                                                                                                       Text="{Binding Reps}"
                                                                                                       FontSize="11"
                                                                                                       WidthRequest="35"
                                                                                                       Keyboard="Numeric"
                                                                                                       VerticalOptions="Center" />

                                                                                                <Label Grid.Column="4"
                                                                                                       Text="Kg:"
                                                                                                       FontSize="10"
                                                                                                       VerticalTextAlignment="Center"
                                                                                                       TextColor="Gray" />

                                                                                                <Entry Grid.Column="5"
                                                                                                       Text="{Binding Weight}"
                                                                                                       FontSize="11"
                                                                                                       WidthRequest="40"
                                                                                                       Keyboard="Numeric"
                                                                                                       VerticalOptions="Center" />

                                                                                                <Button Grid.Column="6"
                                                                                                        Text="✕"
                                                                                                        FontSize="10"
                                                                                                        BackgroundColor="#FFCDD2"
                                                                                                        TextColor="#C62828"
                                                                                                        Padding="4,2"
                                                                                                        Command="{Binding DeleteExerciseCommand}" />
                                                                                            </Grid>

                                                                                        </DataTemplate>
                                                                                    </CollectionView.ItemTemplate>
                                                                                </CollectionView>

                                                                            </VerticalStackLayout>

                                                                        </VerticalStackLayout>
                                                                    </Border>

                                                                </DataTemplate>
                                                            </CollectionView.ItemTemplate>
                                                        </CollectionView>

                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
