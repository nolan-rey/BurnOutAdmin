<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramBuilder"
             xmlns:models="clr-namespace:BurnOutAdmin.Models.Program"
             xmlns:clientModels="clr-namespace:BurnOutAdmin.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="BurnOutAdmin.Views.ProgramBuilder.ProgramBuilderView"
             x:DataType="vm:ProgramBuilderViewModel"
             x:Name="RootView"
             BackgroundColor="#F1F5F9">

<Grid>
<Grid Padding="28,24">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═══ Header ═══ -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <VerticalStackLayout Grid.Column="0" Spacing="3">
            <HorizontalStackLayout Spacing="6">
                <Label Text="Programmes" TextColor="#94A3B8" FontSize="12"/>
                <Label Text="›" TextColor="#CBD5E1" FontSize="12"/>
                <Label Text="Créateur de Séance" TextColor="#475569" FontSize="12" FontAttributes="Bold"/>
            </HorizontalStackLayout>
            <Label Text="Créateur de Séance" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
            <Label Text="Construisez votre séance, puis assignez-la à un client."
                   FontSize="13" TextColor="#94A3B8"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
            <Button Text="Nouvelle séance"
                    Command="{Binding NewSeanceCommand}"
                    BackgroundColor="White" TextColor="#374151"
                    FontAttributes="Bold" FontSize="13"
                    Padding="16,10" CornerRadius="8"
                    BorderColor="#E2E8F0" BorderWidth="1"/>
            <Button Text="Assigner à un client"
                    Command="{Binding OpenAssignPanelCommand}"
                    BackgroundColor="#2563EB" TextColor="White"
                    FontAttributes="Bold" FontSize="13"
                    Padding="18,10" CornerRadius="8"/>
            <Button Text="Sauvegarder"
                    Command="{Binding SaveSeanceCommand}"
                    BackgroundColor="#10B981" TextColor="White"
                    FontAttributes="Bold" FontSize="13"
                    Padding="16,10" CornerRadius="8"/>
        </HorizontalStackLayout>
    </Grid>

    <!-- ═══ Corps : Bibliothèque | Builder ═══ -->
    <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="18">

        <!-- ══ BIBLIOTHÈQUE ══ -->
        <Border Grid.Column="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 14"
                Stroke="#E2E8F0" StrokeThickness="1">
            <Grid RowDefinitions="Auto,1,*">

                <VerticalStackLayout Grid.Row="0" Padding="16,14,16,12" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Bibliothèque" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                            <Label Text="Glissez un exercice dans une sous-catégorie"
                                   FontSize="11" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="+ Ajouter"
                                Command="{Binding OpenAddExerciseCommand}"
                                BackgroundColor="#EFF6FF" TextColor="#2563EB"
                                FontAttributes="Bold" FontSize="11"
                                Padding="10,6" CornerRadius="6" VerticalOptions="Center"/>
                    </Grid>

                    <Border Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36">
                        <Grid ColumnDefinitions="36,*">
                            <Label Grid.Column="0" Text="&#xE8B6;" FontFamily="MaterialIcons"
                                   FontSize="15" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            <Entry Grid.Column="1"
                                   Text="{Binding LibrarySearchText}"
                                   Placeholder="Rechercher…"
                                   PlaceholderColor="#CBD5E1"
                                   TextColor="#0F172A" FontSize="13"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <BoxView Grid.Row="1" BackgroundColor="#F1F5F9"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <CollectionView ItemsSource="{Binding LibraryCategories}"
                                    ItemsLayout="VerticalList"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryCategoryViewModel">
                                <VerticalStackLayout IsVisible="{Binding IsVisible}" Spacing="0">

                                    <Grid Padding="16,9" ColumnDefinitions="Auto,*,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0"
                                               Text="{Binding IsExpanded, Converter={StaticResource CategoryChevronConverter}}"
                                               FontSize="10" TextColor="#94A3B8"
                                               VerticalTextAlignment="Center" Margin="0,0,8,0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="#475569" VerticalTextAlignment="Center"/>
                                        <Border Grid.Column="2"
                                                BackgroundColor="#F1F5F9"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="Transparent" Padding="6,2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Exercises.Count}"
                                                   FontSize="10" TextColor="#64748B"/>
                                        </Border>
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding Exercises}"
                                                    ItemsLayout="VerticalList"
                                                    VerticalScrollBarVisibility="Never"
                                                    IsVisible="{Binding IsExpanded}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ExerciseLibraryItem">
                                                <Border Stroke="Transparent" StrokeThickness="0"
                                                        BackgroundColor="White" Padding="0">
                                                    <Border.GestureRecognizers>
                                                        <DragGestureRecognizer CanDrag="True"
                                                            DragStarting="OnLibraryExerciseDragStarting"/>
                                                    </Border.GestureRecognizers>
                                                    <Grid Padding="16,7,14,7" ColumnDefinitions="Auto,*">
                                                        <Label Grid.Column="0"
                                                               Text="&#xE945;" FontFamily="MaterialIcons"
                                                               FontSize="13" TextColor="#CBD5E1"
                                                               VerticalTextAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}"
                                                                   FontSize="13" TextColor="#1E293B"
                                                                   LineBreakMode="TailTruncation"/>
                                                            <Label Text="{Binding MuscleGroup}"
                                                                   FontSize="10" TextColor="#94A3B8"
                                                                   IsVisible="{Binding MuscleGroup, Converter={StaticResource IsNotNullConverter}}"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

            </Grid>
        </Border>

        <!-- ══ CRÉATEUR DE SÉANCE ══ -->
        <Border Grid.Column="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 14"
                Stroke="#E2E8F0" StrokeThickness="1"
                Padding="24">
            <ScrollView VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="0">

                <!-- ── Infos de la séance ── -->
                <Label Text="SÉANCE" FontSize="11" FontAttributes="Bold"
                       TextColor="#94A3B8" CharacterSpacing="1.5"
                       Padding="0,0,0,12"/>

                <Grid ColumnDefinitions="*,20,*" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Titre de la séance" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#FAFAFA" Padding="0" HeightRequest="40">
                            <Entry Text="{Binding SeanceName}"
                                   Placeholder="Ex : Séance Haut du Corps"
                                   PlaceholderColor="#CBD5E1"
                                   TextColor="#0F172A" FontSize="14"
                                   FontAttributes="Bold" Margin="12,0"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="Notes / Description" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#FAFAFA" Padding="0" HeightRequest="40">
                            <Entry Text="{Binding SeanceDescription}"
                                   Placeholder="Objectifs, remarques…"
                                   PlaceholderColor="#CBD5E1"
                                   TextColor="#0F172A" FontSize="13"
                                   Margin="12,0" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,0,0,20"/>

                <!-- ── Contenu de la séance ── -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           Text="CONTENU DE LA SÉANCE"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#94A3B8" CharacterSpacing="1.5"
                           VerticalTextAlignment="Center"/>

                    <!-- Bouton + Catégorie directement ici -->
                    <Border Grid.Column="1"
                            Stroke="#DBEAFE" StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="#EFF6FF"
                            VerticalOptions="Center" Padding="0"
                            IsVisible="{Binding CurrentSession, Converter={StaticResource IsNotNullConverter}}">
                        <Button Text="+ Catégorie"
                                Command="{Binding CurrentSession.AddCategoryCommand}"
                                FontSize="12" FontAttributes="Bold"
                                TextColor="#2563EB"
                                BackgroundColor="Transparent"
                                Padding="14,7" BorderWidth="0"/>
                    </Border>
                </Grid>

                <!-- ── Séance vide ── -->
                <Border IsVisible="{Binding CurrentSession, Converter={StaticResource IsZeroConverter}}"
                        BackgroundColor="#F8FAFC"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        Padding="30" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="&#xE047;" FontFamily="MaterialIcons"
                               FontSize="32" TextColor="#CBD5E1"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Séance vide"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                        <Label Text="Commencez par ajouter une catégorie ci-dessus"
                               FontSize="12" TextColor="#CBD5E1"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Catégories de la séance ── -->
                <CollectionView ItemsSource="{Binding CurrentSession.Categories}"
                                ItemsLayout="VerticalList"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.EmptyView>
                        <Label Text="Aucune catégorie — utilisez « + Catégorie »"
                               FontSize="12" FontAttributes="Italic"
                               TextColor="#CBD5E1" HorizontalTextAlignment="Center"
                               Padding="0,8"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryViewModel">

                            <!-- ╔══ CATÉGORIE ══╗ -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="#DDD6FE" StrokeThickness="1"
                                    BackgroundColor="#FAF5FF"
                                    Margin="0,0,0,10"
                                    Padding="0">
                                <VerticalStackLayout>

                                    <!-- Header catégorie -->
                                    <Grid Padding="14,11"
                                          ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                          ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#EDE9FE"
                                                StrokeShape="RoundRectangle 5"
                                                Stroke="Transparent"
                                                Padding="8,4" VerticalOptions="Center">
                                            <Label Text="{Binding Order, StringFormat='C{0}'}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="#7C3AED"/>
                                        </Border>
                                        <Entry Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#3B0764"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"/>
                                        <Button Grid.Column="2"
                                                Text="{Binding ExpandIcon}"
                                                FontSize="11" BackgroundColor="Transparent"
                                                TextColor="#A78BFA" Padding="4,2"
                                                Command="{Binding ToggleExpandedCommand}"/>
                                        <Border Grid.Column="3"
                                                Stroke="#DDD6FE" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 5"
                                                BackgroundColor="#EDE9FE"
                                                VerticalOptions="Center" Padding="0">
                                            <Button Text="+ Sous-Cat"
                                                    Command="{Binding AddSubCategoryCommand}"
                                                    FontSize="11" FontAttributes="Bold"
                                                    TextColor="#7C3AED"
                                                    BackgroundColor="Transparent"
                                                    Padding="10,5" BorderWidth="0"/>
                                        </Border>
                                        <Button Grid.Column="4"
                                                Text="✕" FontSize="12"
                                                BackgroundColor="#FEF2F2" TextColor="#EF4444"
                                                Padding="6,3" CornerRadius="5"
                                                VerticalOptions="Center"
                                                Command="{Binding DeleteCategoryCommand}"/>
                                    </Grid>

                                    <!-- Sous-catégories -->
                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                         Padding="10,0,10,10"
                                                         Spacing="6">
                                        <CollectionView ItemsSource="{Binding SubCategories}"
                                                        ItemsLayout="VerticalList"
                                                        VerticalScrollBarVisibility="Never">
                                            <CollectionView.EmptyView>
                                                <Label Text="Aucune sous-catégorie — utilisez « + Sous-Cat »"
                                                       FontSize="11" FontAttributes="Italic"
                                                       TextColor="#CBD5E1"
                                                       HorizontalTextAlignment="Center"
                                                       Padding="0,6"/>
                                            </CollectionView.EmptyView>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubCategoryViewModel">

                                                    <!-- ╔══ SOUS-CATÉGORIE (drop target) ══╗ -->
                                                    <Border StrokeShape="RoundRectangle 8"
                                                            Stroke="#E2E8F0" StrokeThickness="1"
                                                            BackgroundColor="White"
                                                            Margin="0,0,0,6"
                                                            Padding="0">
                                                        <Border.GestureRecognizers>
                                                            <DropGestureRecognizer AllowDrop="True"
                                                                Drop="OnSubCategoryDrop"
                                                                DragOver="OnSubCategoryDragOver"
                                                                DragLeave="OnSubCategoryDragLeave"/>
                                                        </Border.GestureRecognizers>

                                                        <VerticalStackLayout>

                                                            <!-- Header sous-cat -->
                                                            <Grid Padding="12,9,12,9"
                                                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                                                  ColumnSpacing="6"
                                                                  BackgroundColor="#F8FAFC">
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#F1F5F9"
                                                                        StrokeShape="RoundRectangle 4"
                                                                        Stroke="Transparent"
                                                                        Padding="6,2" VerticalOptions="Center">
                                                                    <Label Text="{Binding Order, StringFormat='SC{0}'}"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#64748B"/>
                                                                </Border>
                                                                <Entry Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontSize="13" FontAttributes="Bold"
                                                                       TextColor="#1E293B"
                                                                       VerticalOptions="Center"
                                                                       BackgroundColor="Transparent"/>
                                                                <HorizontalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                                                    <Label Text="Sets" FontSize="9" TextColor="#94A3B8" VerticalTextAlignment="Center"/>
                                                                    <Entry Text="{Binding Sets}" FontSize="11" WidthRequest="32"
                                                                           Keyboard="Numeric" TextColor="#0F172A"
                                                                           HorizontalTextAlignment="Center"/>
                                                                </HorizontalStackLayout>
                                                                <HorizontalStackLayout Grid.Column="3" Spacing="3" VerticalOptions="Center">
                                                                    <Label Text="Repos" FontSize="9" TextColor="#94A3B8" VerticalTextAlignment="Center"/>
                                                                    <Entry Text="{Binding RestTime}" FontSize="11" WidthRequest="32"
                                                                           Keyboard="Numeric" TextColor="#0F172A"
                                                                           HorizontalTextAlignment="Center"/>
                                                                    <Label Text="s" FontSize="9" TextColor="#94A3B8" VerticalTextAlignment="Center"/>
                                                                </HorizontalStackLayout>
                                                                <Button Grid.Column="4"
                                                                        Text="{Binding ExpandIcon}"
                                                                        FontSize="9" BackgroundColor="Transparent"
                                                                        TextColor="#94A3B8" Padding="3,2"
                                                                        Command="{Binding ToggleExpandedCommand}"/>
                                                                <Button Grid.Column="5"
                                                                        Text="✕" FontSize="10"
                                                                        BackgroundColor="Transparent"
                                                                        TextColor="#EF4444" Padding="3,2"
                                                                        Command="{Binding DeleteSubCategoryCommand}"/>
                                                            </Grid>

                                                            <!-- Contenu exercices -->
                                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="0">

                                                                <!-- Zone de drop -->
                                                                <Border Stroke="#BFDBFE" StrokeThickness="1"
                                                                        StrokeDashArray="5,4"
                                                                        StrokeShape="RoundRectangle 6"
                                                                        BackgroundColor="#F0F9FF"
                                                                        Padding="0,8" Margin="12,8,12,4">
                                                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                                                        <Label Text="&#xE2C4;" FontFamily="MaterialIcons"
                                                                               FontSize="13" TextColor="#93C5FD"
                                                                               VerticalTextAlignment="Center"/>
                                                                        <Label Text="Déposez un exercice ici"
                                                                               FontSize="11" TextColor="#60A5FA"
                                                                               VerticalTextAlignment="Center"/>
                                                                    </HorizontalStackLayout>
                                                                </Border>

                                                                <!-- Header colonnes exercices (une seule fois) -->
                                                                <Grid ColumnDefinitions="*,55,55,85,55,32"
                                                                      Padding="12,5,12,4"
                                                                      BackgroundColor="#F8FAFC">
                                                                    <Label Grid.Column="0" Text="EXERCICE"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Label Grid.Column="1" Text="SETS"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                    <Label Grid.Column="2" Text="REPS"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                    <Label Grid.Column="3" Text="CHARGE (KG)"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                    <Label Grid.Column="4" Text="RPE"
                                                                           FontSize="9" FontAttributes="Bold"
                                                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                </Grid>

                                                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="12,0"/>

                                                                <!-- Lignes exercices -->
                                                                <CollectionView ItemsSource="{Binding Exercises}"
                                                                                ItemsLayout="VerticalList"
                                                                                VerticalScrollBarVisibility="Never">
                                                                    <CollectionView.EmptyView>
                                                                        <Label Text="Aucun exercice"
                                                                               FontSize="11" FontAttributes="Italic"
                                                                               TextColor="#CBD5E1"
                                                                               HorizontalTextAlignment="Center"
                                                                               Padding="12,8"/>
                                                                    </CollectionView.EmptyView>
                                                                    <CollectionView.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ExerciseViewModel">
                                                                            <Grid ColumnDefinitions="*,55,55,85,55,32"
                                                                                  Padding="12,5">
                                                                                <Entry Grid.Column="0"
                                                                                       Text="{Binding Name}"
                                                                                       FontSize="13" TextColor="#1E293B"
                                                                                       VerticalOptions="Center"
                                                                                       BackgroundColor="Transparent"/>
                                                                                <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                                                                        StrokeShape="RoundRectangle 5" Padding="0" Margin="2,0" VerticalOptions="Center">
                                                                                    <Entry Text="{Binding Sets}" FontSize="12" Keyboard="Numeric"
                                                                                           TextColor="#0F172A" HorizontalTextAlignment="Center" Margin="4,0"/>
                                                                                </Border>
                                                                                <Border Grid.Column="2" Stroke="#E2E8F0" StrokeThickness="1"
                                                                                        StrokeShape="RoundRectangle 5" Padding="0" Margin="2,0" VerticalOptions="Center">
                                                                                    <Entry Text="{Binding Reps}" FontSize="12" Keyboard="Numeric"
                                                                                           TextColor="#0F172A" HorizontalTextAlignment="Center" Margin="4,0"/>
                                                                                </Border>
                                                                                <Border Grid.Column="3" Stroke="#E2E8F0" StrokeThickness="1"
                                                                                        StrokeShape="RoundRectangle 5" Padding="0" Margin="2,0" VerticalOptions="Center">
                                                                                    <Entry Text="{Binding Weight}" FontSize="12" Keyboard="Numeric"
                                                                                           TextColor="#0F172A" HorizontalTextAlignment="Center"
                                                                                           Placeholder="—" PlaceholderColor="#CBD5E1" Margin="4,0"/>
                                                                                </Border>
                                                                                <Border Grid.Column="4" Stroke="#E2E8F0" StrokeThickness="1"
                                                                                        StrokeShape="RoundRectangle 5" Padding="0" Margin="2,0" VerticalOptions="Center">
                                                                                    <Entry Text="{Binding Rpe}" FontSize="12" Keyboard="Numeric"
                                                                                           TextColor="#0F172A" HorizontalTextAlignment="Center" Margin="4,0"/>
                                                                                </Border>
                                                                                <Button Grid.Column="5"
                                                                                        Text="✕" FontSize="10"
                                                                                        BackgroundColor="Transparent" TextColor="#CBD5E1"
                                                                                        Padding="2,2" VerticalOptions="Center"
                                                                                        Command="{Binding DeleteExerciseCommand}"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </CollectionView.ItemTemplate>
                                                                </CollectionView>

                                                                <!-- Ajouter manuellement -->
                                                                <Border Stroke="#E2E8F0" StrokeThickness="1"
                                                                        StrokeDashArray="4,3"
                                                                        StrokeShape="RoundRectangle 6"
                                                                        BackgroundColor="Transparent"
                                                                        Margin="12,4,12,10" Padding="8,7">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding AddExerciseCommand}"/>
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="+ Ajouter un exercice manuellement"
                                                                           TextColor="#94A3B8" FontSize="11"
                                                                           HorizontalTextAlignment="Center"/>
                                                                </Border>

                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>

                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</Grid>

<!-- ═══ Overlay : Assignation client ═══ -->
<Grid IsVisible="{Binding IsAssignPanelOpen}" BackgroundColor="#60000000">
    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 16"
            Stroke="#E2E8F0" StrokeThickness="1"
            HorizontalOptions="Fill" VerticalOptions="Fill"
            Margin="60,40">
        <Border.Shadow>
            <Shadow Brush="#000" Offset="0,8" Radius="40" Opacity="0.2"/>
        </Border.Shadow>
        <Grid Margin="28" RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Assigner la séance à un client"
                           FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                    <Label Text="Choisissez un client actif et une date de départ."
                           FontSize="13" TextColor="#64748B"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="✕"
                        VerticalOptions="Start"
                        BackgroundColor="Transparent" TextColor="#94A3B8"
                        FontSize="16" Padding="8,4"
                        Command="{Binding CancelAssignCommand}"/>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="20">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                    <Label Grid.Row="0" Text="Sélectionner un client"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="#374151" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC"
                            Padding="0" HeightRequest="36" Margin="0,0,0,10">
                        <Entry Text="{Binding AssignSearchText}"
                               Placeholder="Rechercher un client…"
                               PlaceholderColor="#94A3B8" TextColor="#0F172A"
                               FontSize="13" Margin="12,0"/>
                    </Border>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Clients}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedClient}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="clientModels:Client">
                                <Border Padding="12,10" Margin="0,0,0,6"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E2E8F0" StrokeThickness="1"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#DBEAFE"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="Transparent"
                                                WidthRequest="36" HeightRequest="36"
                                                Margin="0,0,10,0" VerticalOptions="Center">
                                            <Label Text="{Binding FirstName, Converter={StaticResource FirstLetterConverter}}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="#1D4ED8"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label Text="{Binding FullName}" FontSize="13"
                                                   FontAttributes="Bold" TextColor="#1E293B"/>
                                            <Label Text="{Binding Subscription.Type, FallbackValue='—'}"
                                                   FontSize="11" TextColor="#94A3B8"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Status}"
                                               FontSize="11" TextColor="#16A34A"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Border Grid.Column="1" BackgroundColor="#F8FAFC"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E2E8F0" StrokeThickness="1" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Récapitulatif" FontSize="13" FontAttributes="Bold" TextColor="#374151"/>
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Séance" FontSize="11" TextColor="#94A3B8"/>
                            <Label Text="{Binding SeanceName, FallbackValue='—'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Catégories" FontSize="11" TextColor="#94A3B8"/>
                            <Label Text="{Binding CurrentSession.Categories.Count, StringFormat='{0} catégorie(s)'}"
                                   FontSize="13" TextColor="#1E293B"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Client sélectionné" FontSize="11" TextColor="#94A3B8"/>
                            <Label Text="{Binding SelectedClient.FullName, FallbackValue='Aucun client'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Date de début" FontSize="11" TextColor="#94A3B8"/>
                            <DatePicker Date="{Binding AssignStartDate}"
                                        MinimumDate="{x:Static sys:DateTime.Today}"
                                        TextColor="#1E293B" FontSize="13"
                                        Format="dd/MM/yyyy"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,16,0,0">
                <Button Grid.Column="1" Text="Annuler" WidthRequest="110"
                        Command="{Binding CancelAssignCommand}"
                        BackgroundColor="#F1F5F9" TextColor="#475569"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" Padding="12,10"/>
                <Button Grid.Column="2" Text="Confirmer" WidthRequest="150"
                        Command="{Binding ConfirmAssignCommand}"
                        BackgroundColor="#2563EB" TextColor="White"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" Padding="12,10"/>
            </Grid>
        </Grid>
    </Border>
</Grid>

<!-- ═══ Overlay : Ajouter exercice à la bibliothèque ═══ -->
<Grid IsVisible="{Binding IsAddExerciseOpen}" BackgroundColor="#60000000"
      VerticalOptions="Fill" HorizontalOptions="Fill">
    <Grid.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding CancelAddExerciseCommand}"/>
    </Grid.GestureRecognizers>
    <Border BackgroundColor="White" WidthRequest="420"
            VerticalOptions="Center" HorizontalOptions="Center"
            Stroke="#E2E8F0" StrokeThickness="1">
        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#000" Offset="0,8" Radius="40" Opacity="0.15"/></Border.Shadow>
        <Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers>

        <VerticalStackLayout Padding="26" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Ajouter à la bibliothèque"
                           FontSize="17" FontAttributes="Bold" TextColor="#0F172A"/>
                    <Label Text="L'exercice sera sauvegardé et réutilisable."
                           FontSize="12" TextColor="#94A3B8"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="✕"
                        Command="{Binding CancelAddExerciseCommand}"
                        BackgroundColor="Transparent" TextColor="#94A3B8"
                        FontSize="16" Padding="6,4" VerticalOptions="Start"/>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>
            <VerticalStackLayout Spacing="6">
                <Label Text="Nom *" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                <Border Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" BackgroundColor="#FAFAFA"
                        Padding="0" HeightRequest="40">
                    <Entry Text="{Binding NewExerciseName}"
                           Placeholder="Ex : Squat Barre"
                           PlaceholderColor="#CBD5E1"
                           TextColor="#0F172A" FontSize="14" Margin="12,0"/>
                </Border>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,16,*">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="Catégorie *" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                    <Border Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="#FAFAFA"
                            Padding="0" HeightRequest="40">
                        <Picker SelectedItem="{Binding NewExerciseCategory}"
                                ItemsSource="{Binding KnownCategories}"
                                FontSize="13" TextColor="#0F172A" Margin="8,0"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Label Text="Groupe musculaire" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                    <Border Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="#FAFAFA"
                            Padding="0" HeightRequest="40">
                        <Entry Text="{Binding NewExerciseMuscleGroup}"
                               Placeholder="Ex : Jambes"
                               PlaceholderColor="#CBD5E1"
                               TextColor="#0F172A" FontSize="13" Margin="12,0"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                <Button Grid.Column="0" Text="Annuler"
                        Command="{Binding CancelAddExerciseCommand}"
                        BackgroundColor="#F1F5F9" TextColor="#475569"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="42"/>
                <Button Grid.Column="1" Text="Ajouter"
                        Command="{Binding ConfirmAddExerciseCommand}"
                        BackgroundColor="#2563EB" TextColor="White"
                        FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="42"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</Grid>

</Grid>
</ContentView>
