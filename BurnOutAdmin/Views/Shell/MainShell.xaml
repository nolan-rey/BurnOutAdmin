<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BurnOutAdmin.ViewModels"
             xmlns:models="clr-namespace:BurnOutAdmin.Models"
             xmlns:converters="clr-namespace:BurnOutAdmin.Converters"
             x:Class="BurnOutAdmin.Views.Shell.MainShell"
             x:DataType="viewmodels:MainShellViewModel"
             Title="BurnOut Admin"
             BackgroundColor="#F8FAFC">

<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SIDEBAR                                             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              WidthRequest="{Binding IsSidebarExpanded, Converter={StaticResource SidebarWidthConverter}}">
            <!-- White background + right border separator -->
            <BoxView BackgroundColor="White" HorizontalOptions="Fill" VerticalOptions="Fill"/>
            <BoxView WidthRequest="1" BackgroundColor="#E2E8F0" HorizontalOptions="End" VerticalOptions="Fill"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section + Toggle Button -->
                <Grid Grid.Row="0" Margin="12,20,12,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center"
                                           IsVisible="{Binding IsSidebarExpanded}">
                        <Ellipse WidthRequest="36" HeightRequest="36" Fill="#0F172A" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                            <Label Text="Burnout" FontSize="18" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="Supervision v1.2" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                            VerticalOptions="Center" HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSidebarCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xE5D2;" FontFamily="MaterialIcons" FontSize="22"
                               TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Navigation Items -->
                <VerticalStackLayout Grid.Row="1" Margin="12,0" Spacing="2">

                    <!-- Tableau de bord -->
                    <Border BackgroundColor="{Binding MenuItems[0].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="Dashboard"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xE871;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[0].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Tableau de bord" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[0].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Clients -->
                    <Border BackgroundColor="{Binding MenuItems[1].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="Clients"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xE7FB;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[1].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Clients" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[1].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Programmes -->
                    <Border BackgroundColor="{Binding MenuItems[2].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="Programmes"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xE8DF;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[2].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Programmes" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[2].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Program Builder -->
                    <Border BackgroundColor="{Binding MenuItems[3].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="ProgramBuilder"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xE869;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[3].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Program Builder" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[3].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Challenges -->
                    <Border BackgroundColor="{Binding MenuItems[4].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="Challenges"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xEAC9;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[4].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Challenges" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[4].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Journal NFC -->
                    <Border BackgroundColor="{Binding MenuItems[5].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="NfcLogs"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xEF6D;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[5].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Journal NFC" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[5].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="4,14"/>

                    <!-- Paramètres -->
                    <Border BackgroundColor="{Binding MenuItems[6].IsSelected, Converter={StaticResource MenuItemBackgroundConverter}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPageCommand}" CommandParameter="Settings"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="14,11" Spacing="14">
                            <Label Text="&#xE8B8;" FontFamily="MaterialIcons" FontSize="20"
                                   TextColor="{Binding MenuItems[6].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                            <Label Text="Paramètres" FontSize="14"
                                   IsVisible="{Binding IsSidebarExpanded}"
                                   TextColor="{Binding MenuItems[6].IsSelected, Converter={StaticResource MenuItemTextColorConverter}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Logout -->
                <Border Grid.Row="2" StrokeThickness="0" Margin="12,0,12,20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Padding="14,11" Spacing="14">
                        <Label Text="&#xE9BA;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="#E11D48" VerticalOptions="Center"/>
                        <Label Text="Déconnexion" FontSize="14"
                               IsVisible="{Binding IsSidebarExpanded}"
                               TextColor="#E11D48" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT AREA                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ContentView Grid.Column="1"
                     x:Name="ContentArea"
                     BackgroundColor="#F8FAFC"/>

    </Grid>
</ContentPage>
