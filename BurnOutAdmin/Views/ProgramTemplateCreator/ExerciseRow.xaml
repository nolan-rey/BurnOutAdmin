<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramTemplateCreator"
             x:Class="BurnOutAdmin.Views.ProgramTemplateCreator.ExerciseRow"
             x:DataType="vm:TemplateExerciseRowViewModel">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,4">

        <!-- Left: Add Exercise button (dashed style) -->
        <Border Grid.Column="0"
                StrokeShape="RoundRectangle 8"
                Stroke="#D1D5DB"
                StrokeThickness="2"
                StrokeDashArray="6,4"
                BackgroundColor="Transparent"
                HeightRequest="44"
                Padding="0">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="6">
                <Label Text="+"
                       FontSize="14"
                       TextColor="#6B7280"
                       VerticalTextAlignment="Center" />
                <Label Text="Ajouter un exercice"
                       FontSize="13"
                       TextColor="#6B7280"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Right: Inputs row -->
        <HorizontalStackLayout Grid.Column="1" Spacing="8">

            <!-- Sets -->
            <VerticalStackLayout Spacing="2" WidthRequest="65">
                <Label Text="Sets"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="36"
                        Padding="0">
                    <Entry Text="{Binding Sets}"
                           Keyboard="Numeric"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="#111827"
                           BackgroundColor="Transparent"
                           VerticalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Reps -->
            <VerticalStackLayout Spacing="2" WidthRequest="65">
                <Label Text="Reps"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="36"
                        Padding="0">
                    <Entry Text="{Binding Reps}"
                           Keyboard="Numeric"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="#111827"
                           BackgroundColor="Transparent"
                           VerticalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Charge -->
            <VerticalStackLayout Spacing="2" WidthRequest="110">
                <Label Text="Charge (kg/%1RM)"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        BackgroundColor="#F9FAFB"
                        HeightRequest="36"
                        Padding="0">
                    <Entry Text="{Binding Charge}"
                           Placeholder="kg/%1RM"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="#6B7280"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"
                           VerticalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- RPE -->
            <VerticalStackLayout Spacing="2" WidthRequest="65">
                <Label Text="RPE"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="36"
                        Padding="0">
                    <Entry Text="{Binding Rpe}"
                           Keyboard="Numeric"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="#111827"
                           BackgroundColor="Transparent"
                           VerticalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

        </HorizontalStackLayout>
    </Grid>

</ContentView>
