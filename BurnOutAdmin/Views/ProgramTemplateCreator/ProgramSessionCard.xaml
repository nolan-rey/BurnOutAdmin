<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramTemplateCreator"
             xmlns:local="clr-namespace:BurnOutAdmin.Views.ProgramTemplateCreator"
             x:Class="BurnOutAdmin.Views.ProgramTemplateCreator.ProgramSessionCard"
             x:DataType="vm:TemplateSessionViewModel">

    <Border StrokeShape="RoundRectangle 8"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="0"
            Margin="0,0,0,0">

        <VerticalStackLayout>

            <!-- Session Header -->
            <Border BackgroundColor="#F9FAFB"
                    StrokeThickness="0"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding DisplayName}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Column="1"
                           Text="⋮"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteSessionCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Separator -->
            <BoxView HeightRequest="1" Color="#E5E7EB" />

            <!-- Exercise Rows -->
            <VerticalStackLayout Padding="16"
                                 Spacing="8">

                <!-- Existing exercise rows -->
                <VerticalStackLayout Spacing="8"
                                     BindableLayout.ItemsSource="{Binding ExerciseRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TemplateExerciseRowViewModel">
                            <local:ExerciseRow />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Add exercise row (always visible) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,4">

                    <!-- Dashed add button -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#D1D5DB"
                            StrokeThickness="2"
                            StrokeDashArray="6,4"
                            BackgroundColor="Transparent"
                            HeightRequest="44"
                            Padding="0">
                        <HorizontalStackLayout HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="6">
                            <Label Text="+"
                                   FontSize="14"
                                   TextColor="#6B7280"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Ajouter un exercice"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddExerciseCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Static input labels (template placeholder) -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">

                        <VerticalStackLayout Spacing="2" WidthRequest="65">
                            <Label Text="Sets" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="#D1D5DB" StrokeThickness="1"
                                    BackgroundColor="White" HeightRequest="36" Padding="0">
                                <Entry Keyboard="Numeric" FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="#111827" BackgroundColor="Transparent"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" WidthRequest="65">
                            <Label Text="Reps" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="#D1D5DB" StrokeThickness="1"
                                    BackgroundColor="White" HeightRequest="36" Padding="0">
                                <Entry Keyboard="Numeric" FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="#111827" BackgroundColor="Transparent"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" WidthRequest="110">
                            <Label Text="Charge (kg/%1RM)" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="#D1D5DB" StrokeThickness="1"
                                    BackgroundColor="#F9FAFB" HeightRequest="36" Padding="0">
                                <Entry Placeholder="kg/%1RM" FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="#6B7280" PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent" VerticalTextAlignment="Center"
                                       IsEnabled="False" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2" WidthRequest="65">
                            <Label Text="RPE" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="#D1D5DB" StrokeThickness="1"
                                    BackgroundColor="White" HeightRequest="36" Padding="0">
                                <Entry Keyboard="Numeric" FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="#111827" BackgroundColor="Transparent"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>

</ContentView>
