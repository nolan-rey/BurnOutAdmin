<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramTemplateCreator"
             xmlns:local="clr-namespace:BurnOutAdmin.Views.ProgramTemplateCreator"
             x:Class="BurnOutAdmin.Views.ProgramTemplateCreator.ProgramTemplateCreatorView"
             x:DataType="vm:ProgramTemplateCreatorViewModel">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F8FAFC">

        <!-- Row 0: Top Navigation Bar -->
        <local:TopNavigationBar Grid.Row="0" />

        <!-- Row 1: Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24" Spacing="20" MaximumWidthRequest="1280" HorizontalOptions="Center">

                <!-- Page Header -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">

                    <!-- Left: Breadcrumb + Title -->
                    <VerticalStackLayout Grid.Column="0" Spacing="6">

                        <!-- Breadcrumb -->
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Accueil" FontSize="12" TextColor="#6B7280" />
                            <Label Text="/" FontSize="12" TextColor="#6B7280" />
                            <Label Text="Bibliothèque" FontSize="12" TextColor="#6B7280" />
                            <Label Text="/" FontSize="12" TextColor="#6B7280" />
                            <Label Text="Créateur de Modèle" FontSize="12" FontAttributes="Bold" TextColor="#111827" />
                        </HorizontalStackLayout>

                        <Label Text="Création et Import de Modèles de Programmes"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Label Text="Créez et sauvegardez des modèles de programmes d'entraînement pour une utilisation ultérieure."
                               FontSize="13"
                               TextColor="#6B7280"
                               MaximumWidthRequest="600"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Right: Action Buttons -->
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="10"
                                           VerticalOptions="Start">
                        <Button Text="👤 Assigner à un client"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                Padding="16,8"
                                HeightRequest="38"
                                Command="{Binding AssignToClientCommand}" />

                        <Border StrokeShape="RoundRectangle 6"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="0"
                                HeightRequest="38">
                            <Button Text="💾 Sauvegarder dans la Bibliothèque"
                                    BackgroundColor="Transparent"
                                    TextColor="#374151"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="16,8"
                                    BorderWidth="0"
                                    Command="{Binding SaveToLibraryCommand}" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Two Column Layout: Sidebar + Main -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">

                    <!-- Left Sidebar -->
                    <local:ExerciseLibrarySidebar Grid.Column="0" VerticalOptions="Start" />

                    <!-- Right Main Content -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="24"
                            Shadow="{Shadow Brush=#10000000, Offset='0,1', Radius=3}">

                        <VerticalStackLayout Spacing="20">

                            <Label Text="Créateur de Programme"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />

                            <!-- Form Fields -->
                            <VerticalStackLayout Spacing="12">

                                <!-- Titre -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Titre du Modèle"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#374151" />
                                    <Border StrokeShape="RoundRectangle 6"
                                            Stroke="#D1D5DB"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            HeightRequest="40"
                                            Padding="0">
                                        <Entry Text="{Binding TemplateTitle}"
                                               FontSize="13"
                                               TextColor="#111827"
                                               BackgroundColor="Transparent"
                                               VerticalTextAlignment="Center"
                                               Margin="8,0" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Description -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Description"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#374151" />
                                    <Border StrokeShape="RoundRectangle 6"
                                            Stroke="#D1D5DB"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            HeightRequest="80"
                                            Padding="0">
                                        <Editor Text="{Binding TemplateDescription}"
                                                FontSize="13"
                                                TextColor="#111827"
                                                BackgroundColor="Transparent"
                                                AutoSize="TextChanges"
                                                Margin="8,4" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Sessions Section -->
                            <Label Text="Séances"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   Margin="0,8,0,0" />

                            <!-- Session Cards -->
                            <VerticalStackLayout Spacing="16"
                                                 BindableLayout.ItemsSource="{Binding Sessions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TemplateSessionViewModel">
                                        <local:ProgramSessionCard />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Add Session Button -->
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="2"
                                    StrokeDashArray="6,4"
                                    BackgroundColor="#F9FAFB"
                                    HeightRequest="52"
                                    Padding="0">
                                <HorizontalStackLayout HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Spacing="6">
                                    <Label Text="+"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#4B5563"
                                           VerticalTextAlignment="Center" />
                                    <Label Text="Ajouter une séance"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#4B5563"
                                           VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddSessionCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
