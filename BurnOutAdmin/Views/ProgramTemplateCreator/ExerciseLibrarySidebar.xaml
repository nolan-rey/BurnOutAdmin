<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels.ProgramTemplateCreator"
             x:Class="BurnOutAdmin.Views.ProgramTemplateCreator.ExerciseLibrarySidebar"
             x:DataType="vm:ProgramTemplateCreatorViewModel">

    <VerticalStackLayout Spacing="12" WidthRequest="300">

        <!-- Bibliothèque Header Card -->
        <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 8"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="16"
                Shadow="{Shadow Brush=#10000000, Offset='0,1', Radius=3}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Bibliothèque"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#111827" />
                <Label Text="Glisser-déposer vers le calendrier"
                       FontSize="11"
                       TextColor="#6B7280" />
            </VerticalStackLayout>
        </Border>

        <!-- Exercise Library Card -->
        <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 8"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="16"
                Shadow="{Shadow Brush=#10000000, Offset='0,1', Radius=3}">
            <VerticalStackLayout Spacing="12">

                <!-- Title -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Bibliothèque d'exercices"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#111827" />
                    <Label Text="Glisser-déposer vers le calendrier"
                           FontSize="11"
                           TextColor="#6B7280" />
                </VerticalStackLayout>

                <!-- Search Bar -->
                <Border StrokeShape="RoundRectangle 6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="0"
                        HeightRequest="38">
                    <Grid ColumnDefinitions="36,*" Padding="0">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Chercher un exercice..."
                               FontSize="13"
                               TextColor="#111827"
                               PlaceholderColor="#9CA3AF"
                               BackgroundColor="Transparent"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Categories -->
                <VerticalStackLayout Spacing="4"
                                     BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExerciseCategoryViewModel">
                            <VerticalStackLayout Spacing="4">

                                <!-- Category Header Button -->
                                <Border StrokeThickness="0"
                                        BackgroundColor="{Binding IsExpanded, Converter={StaticResource CategoryExpandedBgConverter}}"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="8,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="{Binding IconGlyph}"
                                                   FontSize="14"
                                                   WidthRequest="20"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <Label Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding IsExpanded, Converter={StaticResource CategoryExpandedTextConverter}}"
                                                   VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="{Binding IsExpanded, Converter={StaticResource CategoryChevronConverter}}"
                                               FontSize="10"
                                               TextColor="#9CA3AF"
                                               VerticalTextAlignment="Center" />

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Border>

                                <!-- Exercises List (visible when expanded) -->
                                <VerticalStackLayout Spacing="6"
                                                     Padding="8,0,0,0"
                                                     IsVisible="{Binding IsExpanded}"
                                                     BindableLayout.ItemsSource="{Binding Exercises}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibraryExerciseViewModel">
                                            <Border BackgroundColor="White"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#E5E7EB"
                                                    StrokeThickness="1"
                                                    Padding="12,10"
                                                    Shadow="{Shadow Brush=#08000000, Offset='0,1', Radius=2}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <!-- Blue left accent (simulated with a thin border) -->
                                                    <BoxView Color="#3B82F6"
                                                             WidthRequest="4"
                                                             HorizontalOptions="Start"
                                                             Margin="-12,-10,0,-10"
                                                             CornerRadius="6,0,6,0" />

                                                    <VerticalStackLayout Spacing="6" Padding="4,0,0,0">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#111827" />
                                                            <Label Grid.Column="1"
                                                                   Text="⋮"
                                                                   FontSize="12"
                                                                   TextColor="#9CA3AF" />
                                                        </Grid>

                                                        <!-- Tags -->
                                                        <HorizontalStackLayout Spacing="6"
                                                                               BindableLayout.ItemsSource="{Binding Tags}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border BackgroundColor="#F3F4F6"
                                                                            StrokeThickness="0"
                                                                            StrokeShape="RoundRectangle 4"
                                                                            Padding="8,2">
                                                                        <Label Text="{Binding .}"
                                                                               FontSize="11"
                                                                               TextColor="#374151" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Separator + Mes Modèles -->
                <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,8,0,4" />

                <Border StrokeThickness="0"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 6"
                        Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="📁"
                                   FontSize="14"
                                   WidthRequest="20"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Mes Modèles"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#374151"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="2"
                               Text="▶"
                               FontSize="9"
                               TextColor="#9CA3AF"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentView>
