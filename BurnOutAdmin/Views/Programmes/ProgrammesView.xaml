<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BurnOutAdmin.ViewModels"
             xmlns:cards="clr-namespace:BurnOutAdmin.ViewModels.ProgramBuilder"
             x:Class="BurnOutAdmin.Views.Programmes.ProgrammesView"
             x:DataType="vm:ProgrammesViewModel">

    <Grid BackgroundColor="#F1F5F9">

        <!-- ═══ Contenu principal ═══ -->
        <Grid Padding="28,24" RowDefinitions="Auto,*">

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Programmes" TextColor="#94A3B8" FontSize="12"/>
                        <Label Text="›" TextColor="#CBD5E1" FontSize="12"/>
                        <Label Text="Bibliothèque &amp; Programmes" TextColor="#475569" FontSize="12" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Label Text="Programmes" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                    <Label Text="Gérez vos programmes d'entraînement depuis la base de données."
                           FontSize="13" TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                    <Button Text="↻ Actualiser"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="#F1F5F9" TextColor="#475569"
                            FontSize="13" Padding="14,10" CornerRadius="8"
                            BorderColor="#E2E8F0" BorderWidth="1"/>
                    <Button Text="+ Nouveau programme"
                            Command="{Binding OpenCreateCommand}"
                            BackgroundColor="#4F46E5" TextColor="White"
                            FontAttributes="Bold" FontSize="13"
                            Padding="18,10" CornerRadius="8"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- ─── Deux colonnes ─── -->
            <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="20">

                <!-- ══ GAUCHE : Bibliothèque de Séances (seances-builder) ══ -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <Label Grid.Column="0" Text="Séances sauvegardées"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#1E293B" VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#EEF2FF" StrokeThickness="0"
                                    Padding="10,4" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding SavedSessions.Count}"
                                       FontSize="12" TextColor="#4F46E5" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <!-- État vide -->
                        <VerticalStackLayout Grid.Row="1"
                                             IsVisible="{Binding IsSessionsEmpty}"
                                             Padding="16,40" Spacing="8">
                            <Label Text="📭" FontSize="32" HorizontalTextAlignment="Center"/>
                            <Label Text="Aucune séance sauvegardée"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#64748B" HorizontalTextAlignment="Center"/>
                            <Label Text="Créez des séances dans le Créateur de Séance."
                                   FontSize="12" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Cartes séances — CollectionView gère son propre scroll -->
                        <CollectionView Grid.Row="2"
                                        ItemsSource="{Binding SavedSessions}"
                                        VerticalScrollBarVisibility="Default"
                                        IsVisible="{Binding IsSessionsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="cards:SavedSessionCardViewModel">
                                    <Border Margin="0,0,0,10"
                                            BackgroundColor="#FAFAFA"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="#1E293B"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding SubTitle}"
                                                       FontSize="11" TextColor="#94A3B8"/>
                                                <Label Text="{Binding CreatedAt}"
                                                       FontSize="10" TextColor="#CBD5E1"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Button Text="✏️"
                                                        FontSize="13"
                                                        BackgroundColor="#EEF2FF"
                                                        TextColor="#4F46E5"
                                                        CornerRadius="6"
                                                        Padding="6,4" MinimumWidthRequest="0"
                                                        Command="{Binding EditCommand}"
                                                        ToolTipProperties.Text="Modifier la séance"/>
                                                <Button Text="✕"
                                                        FontSize="11"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#CBD5E1"
                                                        Padding="4,4" MinimumWidthRequest="0"
                                                        Command="{Binding DeleteCommand}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- ══ DROITE : Programmes API ══ -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                    <Grid RowDefinitions="Auto,*">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <Label Grid.Column="0" Text="Programmes"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#1E293B" VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#EEF2FF" StrokeThickness="0"
                                    Padding="10,4" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding Programmes.Count}"
                                       FontSize="12" TextColor="#4F46E5" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Chargement -->
                        <ActivityIndicator Grid.Row="1"
                                           IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#4F46E5"
                                           VerticalOptions="Center" HorizontalOptions="Center"/>

                        <!-- État vide -->
                        <VerticalStackLayout Grid.Row="1"
                                             IsVisible="{Binding IsProgrammesEmpty}"
                                             VerticalOptions="Center" Spacing="10">
                            <Label Text="📋" FontSize="40" HorizontalTextAlignment="Center"/>
                            <Label Text="Aucun programme"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="#64748B" HorizontalTextAlignment="Center"/>
                            <Label Text="Cliquez sur '+ Nouveau programme' pour en créer un."
                                   FontSize="13" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                            <Button Text="+ Nouveau programme"
                                    Command="{Binding OpenCreateCommand}"
                                    BackgroundColor="#4F46E5" TextColor="White"
                                    FontSize="14" Padding="20,12" CornerRadius="8"
                                    HorizontalOptions="Center" Margin="0,8,0,0"/>
                        </VerticalStackLayout>

                        <!-- Liste programmes API — CollectionView gère son propre scroll -->
                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding Programmes}"
                                        IsVisible="{Binding IsProgrammesEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                        VerticalScrollBarVisibility="Default"
                                        Margin="0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProgrammeCardViewModel">

                                    <Border Margin="0,0,0,12"
                                            BackgroundColor="#FAFAFA"
                                            Stroke="#E2E8F0" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="18,14">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                                            <!-- Ligne 1 : icône + nom + statut + boutons -->
                                            <Grid Grid.Row="0"
                                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                  ColumnSpacing="10">

                                                <!-- Icône type -->
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{Binding TypeBadgeBg}"
                                                        StrokeThickness="0"
                                                        WidthRequest="44" HeightRequest="44"
                                                        StrokeShape="RoundRectangle 10"
                                                        VerticalOptions="Center">
                                                    <Label Text="🏋️" FontSize="20"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                <!-- Nom + description -->
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="15" FontAttributes="Bold"
                                                           TextColor="#1E293B" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Description}"
                                                           FontSize="12" TextColor="#64748B"
                                                           LineBreakMode="TailTruncation"/>
                                                </VerticalStackLayout>

                                                <!-- Bouton Modifier -->
                                                <Button Grid.Column="2"
                                                        Text="✏️ Modifier"
                                                        Command="{Binding EditCommand}"
                                                        BackgroundColor="#F8FAFC"
                                                        TextColor="#475569"
                                                        FontSize="12" FontAttributes="Bold"
                                                        Padding="10,6" CornerRadius="8"
                                                        BorderColor="#E2E8F0" BorderWidth="1"
                                                        VerticalOptions="Center"/>

                                                <!-- Bouton Supprimer -->
                                                <Button Grid.Column="3"
                                                        Text="🗑"
                                                        Command="{Binding DeleteCommand}"
                                                        BackgroundColor="#FEF2F2"
                                                        TextColor="#DC2626"
                                                        FontSize="13"
                                                        Padding="10,6" CornerRadius="8"
                                                        BorderColor="#FECACA" BorderWidth="1"
                                                        VerticalOptions="Center"/>

                                                <!-- Date création -->
                                                <Label Grid.Column="4"
                                                       Text="{Binding CreatedAt}"
                                                       FontSize="11" TextColor="#94A3B8"
                                                       VerticalOptions="Center"/>
                                            </Grid>

                                            <!-- Ligne 2 : badges type + niveau + statut + durée -->
                                            <HorizontalStackLayout Grid.Row="1" Spacing="8">

                                                <!-- Badge type -->
                                                <Border BackgroundColor="{Binding TypeBadgeBg}"
                                                        StrokeThickness="0"
                                                        Padding="8,3" StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding TypeText}"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="{Binding TypeBadgeColor}"/>
                                                </Border>

                                                <!-- Badge niveau -->
                                                <Border BackgroundColor="#F0F9FF"
                                                        StrokeThickness="0"
                                                        Padding="8,3" StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding LevelText}"
                                                           FontSize="11" TextColor="#0369A1"/>
                                                </Border>

                                                <!-- Badge statut -->
                                                <Border BackgroundColor="{Binding StatusBg}"
                                                        StrokeThickness="0"
                                                        Padding="8,3" StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding StatusText}"
                                                           FontSize="11" TextColor="{Binding StatusColor}"/>
                                                </Border>

                                                <!-- Durée -->
                                                <Label Text="{Binding DurationText}"
                                                       FontSize="12" TextColor="#64748B"
                                                       VerticalOptions="Center"/>

                                            </HorizontalStackLayout>

                                            <!-- Ligne 3 : boutons Séances + Assigner -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button Grid.Column="0"
                                                        Text="📋 Séances"
                                                        Command="{Binding ManageSeancesCommand}"
                                                        BackgroundColor="White" TextColor="#4F46E5"
                                                        FontSize="13" FontAttributes="Bold"
                                                        Padding="0,10" CornerRadius="8"
                                                        BorderColor="#4F46E5" BorderWidth="1"
                                                        HorizontalOptions="Fill"/>
                                                <Button Grid.Column="1"
                                                        Text="Assigner à des clients"
                                                        Command="{Binding AssignCommand}"
                                                        BackgroundColor="#4F46E5" TextColor="White"
                                                        FontSize="13" FontAttributes="Bold"
                                                        Padding="0,10" CornerRadius="8"
                                                        HorizontalOptions="Fill"/>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══ Modal Créer / Modifier Programme ═══ -->
        <Grid IsVisible="{Binding IsModalOpen}"
              BackgroundColor="#AA000000">
            <Border BackgroundColor="White"
                    WidthRequest="500"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">

                    <!-- Titre -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding ModalTitle}"
                               FontSize="20" FontAttributes="Bold" TextColor="#1E293B"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✕" FontSize="14"
                                BackgroundColor="Transparent" TextColor="#94A3B8"
                                Padding="8,4" MinimumWidthRequest="0"
                                Command="{Binding CancelModalCommand}"/>
                    </Grid>

                    <!-- Nom -->
                    <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Entry Text="{Binding ModalNom}"
                               Placeholder="Nom du programme *"
                               PlaceholderColor="#94A3B8"
                               FontSize="14" TextColor="#1E293B" Margin="14,0"/>
                    </Border>

                    <!-- Description -->
                    <Border Grid.Row="2" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Entry Text="{Binding ModalDescription}"
                               Placeholder="Description (optionnel)"
                               PlaceholderColor="#94A3B8"
                               FontSize="14" TextColor="#1E293B" Margin="14,0"/>
                    </Border>

                    <!-- Type -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Type :"
                               FontSize="13" TextColor="#374151" VerticalOptions="Center"/>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Picker ItemsSource="{Binding TypeItems}"
                                    SelectedIndex="{Binding ModalTypeIndex}"
                                    FontSize="13" TextColor="#1E293B" Margin="14,0"/>
                        </Border>
                    </Grid>

                    <!-- Niveau -->
                    <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Niveau :"
                               FontSize="13" TextColor="#374151" VerticalOptions="Center"/>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Picker ItemsSource="{Binding NiveauItems}"
                                    SelectedIndex="{Binding ModalNiveauIndex}"
                                    FontSize="13" TextColor="#1E293B" Margin="14,0"/>
                        </Border>
                    </Grid>

                    <!-- Durée + Séances/semaine -->
                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{Binding ModalDuree, StringFormat='Durée : {0} semaines'}"
                                   FontSize="13" TextColor="#374151"/>
                            <Slider Minimum="1" Maximum="52" Value="{Binding ModalDuree}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding ModalSeances, StringFormat='Séances : {0}/semaine'}"
                                   FontSize="13" TextColor="#374151"/>
                            <Slider Minimum="1" Maximum="7" Value="{Binding ModalSeances}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Erreur -->
                    <Label Grid.Row="6"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="12" TextColor="#DC2626"/>

                    <!-- Boutons -->
                    <Grid Grid.Row="7" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelModalCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <!-- Bouton Créer (visible si pas en mode édition) -->
                        <Button Grid.Column="1" Text="Créer le programme"
                                IsVisible="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}"
                                Command="{Binding ConfirmModalCommand}"
                                BackgroundColor="#4F46E5" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <!-- Bouton Enregistrer (visible si en mode édition) -->
                        <Button Grid.Column="1" Text="Enregistrer"
                                IsVisible="{Binding IsEditMode}"
                                Command="{Binding ConfirmModalCommand}"
                                BackgroundColor="#16A34A" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Overlay confirmation suppression ═══ -->
        <Grid IsVisible="{Binding IsDeleteConfirmOpen}"
              BackgroundColor="#AA000000">
            <Border BackgroundColor="White"
                    WidthRequest="380"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 16"
                    Padding="24">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Supprimer le programme ?"
                           FontSize="18" FontAttributes="Bold" TextColor="#1E293B"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding CardPendingDelete.Name}"
                           FontSize="14" TextColor="#64748B"
                           HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                    <Label Text="Cette action est irréversible."
                           FontSize="13" TextColor="#94A3B8"
                           HorizontalTextAlignment="Center"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelDeleteCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" Padding="0,14" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Supprimer"
                                Command="{Binding ConfirmDeleteCommand}"
                                BackgroundColor="#DC2626" TextColor="White"
                                FontAttributes="Bold" Padding="0,14" CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ Overlay Assignation ═══ -->
        <Grid IsVisible="{Binding IsAssignPanelOpen}"
              BackgroundColor="#AA000000">
            <Border BackgroundColor="White"
                    WidthRequest="500"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,Auto,220,Auto" RowSpacing="18">

                    <!-- En-tête -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Assigner à des clients"
                                   FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Label Text="{Binding AssignTargetName}"
                                   FontSize="13" TextColor="#4F46E5" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="✕" FontSize="14"
                                BackgroundColor="Transparent" TextColor="#94A3B8"
                                Padding="8,4" MinimumWidthRequest="0"
                                Command="{Binding CancelAssignCommand}"/>
                    </Grid>

                    <!-- Date début -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Date de début :"
                               FontSize="13" TextColor="#374151" VerticalOptions="Center"/>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" BackgroundColor="White"
                                Padding="14,0" HeightRequest="44">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Date affichée lisiblement -->
                                <Label Grid.Column="0"
                                       Text="{Binding AssignStartDate, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="13" TextColor="#1E293B"
                                       VerticalOptions="Center"
                                       InputTransparent="True"/>
                                <Label Grid.Column="1" Text="📅"
                                       FontSize="14" VerticalOptions="Center"
                                       InputTransparent="True"/>
                                <!-- DatePicker opaque mais texte transparent = cliquable, invisible -->
                                <DatePicker Grid.Column="0" Grid.ColumnSpan="2"
                                            Date="{Binding AssignStartDate}"
                                            TextColor="Transparent"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Fill" HorizontalOptions="Fill"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Titre liste -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Clients actifs"
                               FontSize="13" FontAttributes="Bold" TextColor="#374151"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#4F46E5" StrokeThickness="0"
                                Padding="10,4" StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding SelectableClients.Count}"
                                   FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Liste clients -->
                    <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Default">
                        <CollectionView ItemsSource="{Binding SelectableClients}"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClientSelectionViewModel">
                                    <Border Margin="0,0,0,8"
                                            BackgroundColor="{Binding RowBackground}"
                                            Stroke="{Binding CheckBorderColor}"
                                            StrokeThickness="1.5" StrokeShape="RoundRectangle 10"
                                            Padding="14,11">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleSelectionCommand}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#4F46E5" StrokeThickness="0"
                                                    WidthRequest="36" HeightRequest="36"
                                                    StrokeShape="RoundRectangle 18">
                                                <Label Text="{Binding Initials}"
                                                       FontSize="12" FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding FullName}"
                                                   FontSize="14" TextColor="#1E293B"
                                                   VerticalOptions="Center"/>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding CheckBackground}"
                                                    Stroke="{Binding CheckBorderColor}" StrokeThickness="2"
                                                    WidthRequest="22" HeightRequest="22"
                                                    StrokeShape="RoundRectangle 6"
                                                    VerticalOptions="Center">
                                                <Label Text="✓" FontSize="12" TextColor="White"
                                                       IsVisible="{Binding IsSelected}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>

                    <!-- Boutons -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelAssignCommand}"
                                BackgroundColor="#F1F5F9" TextColor="#374151"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Assigner"
                                Command="{Binding ConfirmAssignCommand}"
                                BackgroundColor="#16A34A" TextColor="White"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- ==================== GESTION SÉANCES DU PROGRAMME ==================== -->
        <Grid IsVisible="{Binding IsManageSeancesOpen}" BackgroundColor="#80000000"
              VerticalOptions="Fill" HorizontalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseManageSeancesCommand}"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" WidthRequest="640"
                    MaximumHeightRequest="720"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow><Shadow Brush="#000" Offset="0,8" Radius="32" Opacity="0.2"/></Border.Shadow>
                <Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="24,20" ColumnDefinitions="*,Auto"
                          BackgroundColor="#F8FAFC">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Séances du programme" FontSize="18"
                                   FontAttributes="Bold" TextColor="#0F172A"/>
                            <Label Text="{Binding SeancesTargetProgramme.Name}"
                                   FontSize="13" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="✕"
                               FontSize="18" TextColor="#94A3B8"
                               WidthRequest="32" HeightRequest="32"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseManageSeancesCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Liste des séances + bouton ajouter -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="24" Spacing="14">

                            <!-- Bouton + Ajouter une séance -->
                            <Button Text="+ Ajouter une séance depuis la bibliothèque"
                                    Command="{Binding OpenAddSeanceFromLibraryCommand}"
                                    BackgroundColor="#EEF2FF" TextColor="#4F46E5"
                                    FontSize="13" FontAttributes="Bold"
                                    Padding="0,12" CornerRadius="8"
                                    HorizontalOptions="Fill"/>

                            <!-- Empty state -->
                            <Border IsVisible="{Binding IsProgrammeSeancesEmpty}"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="24" Margin="0,4">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="📋" FontSize="28"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="Aucune séance dans ce programme"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#475569" HorizontalTextAlignment="Center"/>
                                    <Label Text="Ajoutez-en une depuis la bibliothèque ci-dessus."
                                           FontSize="12" TextColor="#94A3B8"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Cards séances -->
                            <CollectionView ItemsSource="{Binding ProgrammeSeances}"
                                            ItemsLayout="VerticalList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProgrammeSeanceCardViewModel">
                                        <Border BackgroundColor="White"
                                                Stroke="#E2E8F0" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10"
                                                Margin="0,0,0,8" Padding="14,12">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                  ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="#EEF2FF"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,4" VerticalOptions="Center">
                                                    <Label Text="{Binding OrderText}"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="#4F46E5"/>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="14" FontAttributes="Bold"
                                                           TextColor="#0F172A"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Description}"
                                                           FontSize="11" TextColor="#94A3B8"
                                                           LineBreakMode="TailTruncation"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2"
                                                       Text="{Binding ContentText}"
                                                       FontSize="11" TextColor="#64748B"
                                                       VerticalOptions="Center"/>
                                                <Button Grid.Column="3" Text="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        BackgroundColor="#FEF2F2"
                                                        TextColor="#DC2626"
                                                        FontSize="12"
                                                        Padding="10,6" CornerRadius="6"
                                                        BorderColor="#FECACA" BorderWidth="1"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Footer -->
                    <Border Grid.Row="2" BackgroundColor="#F8FAFC"
                            StrokeThickness="0" Padding="24,14">
                        <Button Text="Fermer"
                                Command="{Binding CloseManageSeancesCommand}"
                                BackgroundColor="White"
                                BorderColor="#E2E8F0" BorderWidth="1"
                                TextColor="#374151"
                                FontAttributes="Bold" FontSize="13"
                                Padding="20,10" CornerRadius="8"
                                HorizontalOptions="End"/>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ==================== PICKER AJOUTER UNE SÉANCE DEPUIS LA BIBLIOTHÈQUE ==================== -->
        <Grid IsVisible="{Binding IsAddSeanceFromLibraryOpen}" BackgroundColor="#80000000"
              VerticalOptions="Fill" HorizontalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelAddSeanceFromLibraryCommand}"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" WidthRequest="520" MaximumHeightRequest="620"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow><Shadow Brush="#000" Offset="0,8" Radius="32" Opacity="0.2"/></Border.Shadow>
                <Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">

                    <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="*,Auto"
                          BackgroundColor="#F8FAFC">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Choisir une séance" FontSize="16"
                                   FontAttributes="Bold" TextColor="#0F172A"/>
                            <Label Text="Sélectionnez une séance de la bibliothèque à ajouter au programme."
                                   FontSize="11" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="✕" FontSize="16" TextColor="#94A3B8"
                               WidthRequest="28" HeightRequest="28"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelAddSeanceFromLibraryCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="20" Spacing="8">
                            <CollectionView ItemsSource="{Binding SavedSessions}"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedTemplate}">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Padding="0,40">
                                        <Label Text="Aucune séance sauvegardée." FontSize="14"
                                               FontAttributes="Bold" TextColor="#475569"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Créez-en une dans le Créateur de Séance."
                                               FontSize="12" TextColor="#94A3B8"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="cards:SavedSessionCardViewModel">
                                        <Border BackgroundColor="White"
                                                Stroke="#E2E8F0" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Margin="0,0,0,6" Padding="12,10">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="CommonStates">
                                                    <VisualState Name="Normal"/>
                                                    <VisualState Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#EEF2FF"/>
                                                            <Setter Property="Stroke" Value="#4F46E5"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="14" FontAttributes="Bold"
                                                           TextColor="#0F172A"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Description}"
                                                           FontSize="11" TextColor="#94A3B8"
                                                           LineBreakMode="TailTruncation"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="{Binding SubTitle}"
                                                       FontSize="11" TextColor="#64748B"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2" Padding="20,14" BackgroundColor="#F8FAFC"
                          ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Annuler"
                                Command="{Binding CancelAddSeanceFromLibraryCommand}"
                                BackgroundColor="White" BorderColor="#E2E8F0" BorderWidth="1"
                                TextColor="#374151" FontAttributes="Bold" FontSize="13"
                                Padding="0,12" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Ajouter au programme"
                                Command="{Binding ConfirmAddSeanceFromLibraryCommand}"
                                BackgroundColor="#16A34A" TextColor="White"
                                FontAttributes="Bold" FontSize="13"
                                Padding="0,12" CornerRadius="8"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentView>
